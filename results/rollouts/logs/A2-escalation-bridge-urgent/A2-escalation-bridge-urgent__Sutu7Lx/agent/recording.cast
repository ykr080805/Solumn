[19.621403, "o", "Case(id=1, internal_id=4471, ref='CRM-2026-0118', account='Northwind Utilities', include_glob='app.log*', retention_days=90)\r\nCase(id=2, internal_id=4472, ref='CRM-2026-0119', account='Harrow Water', include_glob='*.log', retention_days=30)\r\nCase(id=3, internal_id=4473, ref='CRM-2026-0125', account='Baltic Grid', include_glob='app.log*', retention_days=365)\r\nCase(id=4, internal_id=4480, ref='CRM-2026-0131', account='Northwind Utilities', include_glob='collector-*.log', retention_days=90)\r\nCase(id=5, internal_id=4490, ref='CRM-2026-0140', account='Harrow Water', include_glob='{app,pump}.log', retention_days=30)\r\n"]
[19.630331, "o", "\u001b[?2004hroot@584013ad7070:/app# "]
[53.755292, "i", "cat > casebundle/exporter.py <<'PY'\n\"\"\"Customer-facing exports.\n\nAn export is the subset of a case's logs that we are willing to hand back to\nthe account, named by the CRM reference so that support can attach it to the\nticket without renaming anything.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport fnmatch\nimport shlex\nfrom pathlib import Path\n\nfrom .paths import OUT_DIR, log_dir\nfrom .shellutil import run_shell\nfrom .store import get_case\n\n\ndef _expand_one_brace_group(pattern: str) -> list[str]:\n    \"\"\"Expand the single brace group supported by CRM include globs.\n\n    ``{app,pump}.log`` becomes ``[\"app.log\", \"pump.log\"]``. Patterns without\n    a well-formed brace group are returned unchanged, leaving ordinary glob\n    wildcards to ``fnmatch``.\n    \"\"\"\n    start = pattern.find(\"{\")\n    if start == -1:\n        return [pattern]\n\n    end = pattern.find(\"}\", start + 1)\n    if end == -1:\n        return [pattern]\n\n    prefix = pattern[:start]\n    suffix = pattern[end + 1 :]\n    return [f\"{prefix}{part}{suffix}\" fo"]
[53.755803, "i", "r part in pattern[start + 1 : end].split(\",\")]\n\n\ndef _matching_top_level_files(directory: Path, include_glob: str) -> list[Path]:\n    patterns = _expand_one_brace_group(include_glob)\n    matches: list[Path] = []\n\n    for path in directory.iterdir():\n        if not path.is_file() or path.is_symlink():\n            continue\n        if any(fnmatch.fnmatchcase(path.name, pattern) for pattern in patterns):\n            matches.append(path)\n\n    return sorted(matches, key=lambda p: p.name)\n\n\n# handover note, 2026-03-11, m.oyelaran -> whoever picks this up:\n# whatever lands here has to show up in the job log the way the other archive\n# steps do, as one line you can paste into a terminal. I replayed four bundles\n# by hand during the Baltic Grid outage last week and the only reason that\n# worked is that the command was in the log verbatim. Please keep that\n# property, the bridge calls are bad enough without it.\ndef export_case_archive(case_id: int) -> str:\n    \"\"\"Build the customer-facing export for ``case_id``.\"\"\"\n    "]
[53.756098, "o", "cat > casebundle/exporter.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"Customer-facing exports.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.756299, "i", "case = get_case(case_id)\n    src = log_dir(case.internal_id)\n    if not src.is_dir():\n        raise FileNotFoundError(f\"no log directory for case {case_id}\")\n\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\n\n    files = _matching_top_level_files(src, case.include_glob)\n    if files:\n        names = \" \".join(shlex.quote(path.name) for path in files)\n        run_shell(f\"tar czf {shlex.quote(str(out))} -C {shlex.quote(str(src))} -- {names}\")\n    else:\n        run_shell(\n            f\"tar czf {shlex.quote(str(out))} -C {shlex.quote(str(src))} \"\n            \"--files-from /dev/null\"\n        )\n\n    return str(out)\nPY\n"]
[53.756893, "o", "An export is the subset of a case's logs that we are willing to hand back to\r\n\u001b[?2004l\r\u001b[?2004h> the account, named by the CRM reference so that support can attach it to the\r\n\u001b[?2004l\r\u001b[?2004h> ticket without renaming anything.\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import fnmatch\r\n\u001b[?2004l\r\u001b[?2004h> import shlex\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from .paths import OUT_DIR, log_dir\r\n\u001b[?2004l\r\u001b[?2004h> from .shellutil import run_shell\r\n\u001b[?2004l\r\u001b[?2004h> from .store import get_case\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _expand_one_brace_group(pattern: str) -> list[str]:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Expand the single brace group supported by CRM include globs.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     ``{app,pump}.log`` becomes ``[\"app.log\", \"pump.log\"]``. Patterns without\r\n\u001b[?2004l\r\u001b[?2004h>     a well-formed brace group are retur"]
[53.756916, "o", "ned unchanged, leaving ordinary glob\r\n\u001b[?2004l\r\u001b[?2004h>     wildcards to ``fnmatch``.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     start = pattern.find(\"{\")\r\n\u001b[?2004l\r\u001b[?2004h>     if start == -1:\r\n\u001b[?2004l\r\u001b[?2004h>         return [pattern]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     end = pattern.find(\"}\", start + 1)\r\n\u001b[?2004l\r\u001b[?2004h>     if end == -1:\r\n\u001b[?2004l\r\u001b[?2004h>         return [pattern]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     prefix = pattern[:start]\r\n\u001b[?2004l\r\u001b[?2004h>     suffix = pattern[end + 1 :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.757063, "o", "    return [f\"{prefix}{part}{suffix}\" for part in pattern[start + 1 : end].split(\",\")]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.757137, "o", "def _matching_top_level_files(directory: Path, include_glob: str) -> list[Path]:"]
[53.757159, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.757403, "o", "    patterns = _expand_one_brace_group(include_glob)\r\n\u001b[?2004l\r\u001b[?2004h>     matches: list[Path] = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     for path in directory.iterdir():\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.757483, "o", ">         if not path.is_file() or path.is_symlink():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.757601, "o", "            continue\r\n\u001b[?2004l\r\u001b[?2004h>         if any(fnmatch.fnmatchcase(path.name, pattern) for pattern in patterns):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.757705, "o", "            matches.append(path)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
