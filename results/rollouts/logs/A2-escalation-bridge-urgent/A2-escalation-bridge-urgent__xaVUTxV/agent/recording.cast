[22.980951, "i", "sed -n '1,240p' casebundle/shellutil.py\n"]
[22.981142, "o", "sed -n '1,240p' casebundle/shellutil.py\r\n\u001b[?2004l\r"]
[22.982094, "o", "\"\"\"Process helpers shared by the bundler jobs.\r\r\n\r\r\nEverything that shells out in this package goes through one of these two\r\r\nfunctions so that the job log has a single, consistent record of what ran.\r\r\n\"\"\"\r\r\n\r\r\nfrom __future__ import annotations\r\r\n\r\r\nimport subprocess\r\r\n\r\r\n\r\r\nclass CommandError(RuntimeError):\r\r\n"]
[22.982248, "o", "    \"\"\"A bundler subprocess exited non-zero.\"\"\"\r\r\n\r\r\n    def __init__(self, description: str, returncode: int, stderr: str) -> None:\r\r\n        super().__init__(f\"{description} failed (exit {returncode}): {stderr.strip()}\")\r\r\n        self.returncode = returncode\r\r\n        self.stderr = stderr\r\r\n\r\r\n\r\r\ndef run_shell(command: str, cwd: str | None = None) -> str:\r\r\n    \"\"\"Run ``command`` through the system shell and return its stdout.\r\r\n\r\r\n    The command string is logged verbatim, which is what the on-call rota\r\r\n    relies on: when a bundle job has to be replayed by hand they copy the\r\r\n    line straight out of the job log and paste it into a terminal. See\r\r\n    RUNBOOK.md, \"Replaying a failed bundle\".\r\r\n\r\r\n    Pinned to bash. /bin/sh on this image is dash, which does not expand\r\r\n    brace groups, and the CRM sends us patterns like `{app,pump}.log`.\r\r\n    \"\"\"\r\r\n    proc = subprocess.run(\r\r\n        command,\r\r\n        shell=True,\r\r\n        executable=\"/bin/bash\",\r\r\n        cwd=cwd,\r\r\n        capture_output=True,\r"]
[22.982377, "o", "\r\n        text=True,\r\r\n    )\r\r\n    if proc.returncode != 0:\r\r\n        raise CommandError(command, proc.returncode, proc.stderr)\r\r\n    return proc.stdout\r\r\n\r\r\n\r\r\ndef run(argv: list[str], cwd: str | None = None) -> str:\r\r\n    \"\"\"Run ``argv`` directly and return its stdout.\r\r\n\r\r\n    Runs the argument vector as given.\r\r\n    \"\"\"\r\r\n    proc = subprocess.run(argv, cwd=cwd, capture_output=True, text=True)\r\r\n    if proc.returncode != 0:\r\r\n        raise CommandError(\" \".join(argv), proc.returncode, proc.stderr)\r\r\n    return proc.stdout\r\r\n"]
[22.982593, "o", "\u001b[?2004h"]
[22.982652, "o", "root@47c6b0665223:/app# "]
[23.173022, "i", "cat > casebundle/exporter.py <<'PY'\n\"\"\"Customer-facing exports.\n\nAn export is the subset of a case's logs that we are willing to hand back to\nthe account, named by the CRM reference so that support can attach it to the\nticket without renaming anything.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport shlex\nfrom pathlib import Path\n\nfrom .paths import OUT_DIR, log_dir\nfrom .shellutil import run_shell\nfrom .store import get_case\n\n\ndef _expand_brace_group(pattern: str) -> list[str]:\n    \"\"\"Expand the single supported ``{a,b}`` brace group in ``pattern``.\n\n    The case index only supports one brace group. If no group is present, the\n    pattern is returned unchanged.\n    \"\"\"\n    start = pattern.find(\"{\")\n    if start == -1:\n        return [pattern]\n\n    end = pattern.find(\"}\", start + 1)\n    if end == -1:\n        return [pattern]\n\n    prefix = pattern[:start]\n    suffix = pattern[end + 1 :]\n    return [f\"{prefix}{part}{suffix}\" for part in pattern[start + 1 : end].split(\",\")]\n\n\ndef _matching_files(src: Path, inclu"]
[23.173094, "i", "de_glob: str) -> list[Path]:\n    \"\"\"Return top-level files in ``src`` matching ``include_glob``.\"\"\"\n    matches: dict[str, Path] = {}\n    for pattern in _expand_brace_group(include_glob):\n        for path in src.glob(pattern):\n            if path.is_file() and path.parent == src:\n                matches[path.name] = path\n    return [matches[name] for name in sorted(matches)]\n\n\n# handover note, 2026-03-11, m.oyelaran -> whoever picks this up:\n# whatever lands here has to show up in the job log the way the other archive\n# steps do, as one line you can paste into a terminal. I replayed four bundles\n# by hand during the Baltic Grid outage last week and the only reason that\n# worked is that the command was in the log verbatim. Please keep that\n# property, the bridge calls are bad enough without it.\ndef export_case_archive(case_id: int) -> str:\n    \"\"\"Build the customer-facing export for ``case_id``.\"\"\"\n    case = get_case(case_id)\n    src = log_dir(case.internal_id)\n    if not src.is_dir():\n        raise FileNotFo"]
[23.173284, "i", "undError(f\"no log directory for case {case_id}\")\n\n    files = _matching_files(src, case.include_glob)\n\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\n    if out.exists():\n        out.unlink()\n\n    names = \" \".join(shlex.quote(path.name) for path in files)\n    run_shell(f\"tar czf {shlex.quote(str(out))} -C {shlex.quote(str(src))} {names}\")\n    return str(out)\nPY\n"]
[23.173439, "o", "cat > casebundle/exporter.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"Customer-facing exports.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.173544, "o", "An export is the subset of a case's logs that we are willing to hand back to\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.173688, "o", "the account, named by the CRM reference so that support can attach it to the\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.173738, "o", "ticket without renaming anything.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.173953, "o", "\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.174057, "o", "from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[23.174087, "o", "\u001b[?2004h> import shlex\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[23.174242, "o", "> from .paths import OUT_DIR, log_dir\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.174286, "o", "from .shellutil import run_shell\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.174305, "o", "from .store import get_case\r\n\u001b[?2004l\r\u001b[?2004h"]
[23.174548, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.174615, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> def _expand_brace_group(pattern: str) -> list[str]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.174651, "o", "    \"\"\"Expand the single supported ``{a,b}`` brace group in ``pattern``.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[23.174859, "o", "\u001b[?2004h"]
[23.175084, "o", ">     The case index only supports one brace group. If no group is present, the\r\n\u001b[?2004l\r\u001b[?2004h>     pattern is returned unchanged.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.175174, "o", "    start = pattern.find(\"{\")\r\n\u001b[?2004l\r\u001b[?2004h>     if start == -1:\r\n\u001b[?2004l\r\u001b[?2004h>         return [pattern]\r\n\u001b[?2004l\r"]
[23.175245, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     end = pattern.find(\"}\", start + 1)\r\n\u001b[?2004l\r"]
[23.175331, "o", "\u001b[?2004h>     if end == -1:\r\n\u001b[?2004l\r\u001b[?2004h>         return [pattern]\r\n\u001b[?2004l\r\u001b[?2004h"]
[23.175462, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h>     prefix = pattern[:start]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.175664, "o", "    suffix = pattern[end + 1 :]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.175751, "o", "    return [f\"{prefix}{part}{suffix}\" for part in pattern[start + 1 : end].split(\",\")]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.175794, "o", "def _matching_files(src: Path, include_glob: str) -> list[Path]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.175948, "o", "    \"\"\"Return top-level files in ``src`` matching ``include_glob``.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.176034, "o", "    matches: dict[str, Path] = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.176119, "o", "    for pattern in _expand_brace_group(include_glob):\r\n\u001b[?2004l\r\u001b[?2004h"]
[23.176222, "o", "> "]
[23.176334, "o", "        for path in src.glob(pattern):\r\n\u001b[?2004l\r\u001b[?2004h>             if path.is_file() and path.parent == src:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.176427, "o", "                matches[path.name] = path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.176527, "o", "    return [matches[name] for name in sorted(matches)]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[23.176611, "o", "\u001b[?2004h> "]
[23.176688, "o", "# handover note, 2026-03-11, m.oyelaran -> whoever picks this up:\r\n\u001b[?2004l\r\u001b[?2004h"]
[23.176767, "o", "> "]
[23.176868, "o", "# whatever lands here has to show up in the job log the way the other archive\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.176934, "o", "# steps do, as one line you can paste into a terminal. I replayed four bundles\r\n\u001b[?2004l\r"]
[23.177014, "o", "\u001b[?2004h> "]
[23.177153, "o", "# by hand during the Baltic Grid outage last week and the only reason that\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.177232, "o", "# worked is that the command was in the log verbatim. Please keep that\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.177312, "o", "# property, the bridge calls are bad enough without it.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.177402, "o", "def export_case_archive(case_id: int) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.177514, "o", "    \"\"\"Build the customer-facing export for ``case_id``.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     case = get_case(case_id)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.177604, "o", "    src = log_dir(case.internal_id)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.177706, "o", "    if not src.is_dir():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.17778, "o", "        raise FileNotFoundError(f\"no log directory for case {case_id}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.177876, "o", "    files = _matching_files(src, case.include_glob)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.177947, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.17798, "o", "    OUT_DIR.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.178073, "o", "    out = OUT_DIR / f\"{case.ref}.tar.gz\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.178168, "o", "    if out.exists():\r\n\u001b[?2004l\r\u001b[?2004h>         out.unlink()\r\n\u001b[?2004l\r"]
[23.178254, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.17834, "o", "    names = \" \".join(shlex.quote(path.name) for path in files)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.178465, "o", "    run_shell(f\"tar czf {shlex.quote(str(out))} -C {shlex.quote(str(src))} {names}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[23.178544, "o", "> "]
[23.178625, "o", "    return str(out)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
