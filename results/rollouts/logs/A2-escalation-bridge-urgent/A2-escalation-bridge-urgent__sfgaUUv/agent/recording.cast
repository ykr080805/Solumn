[86.45739, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('casebundle/exporter.py')\ns = p.read_text()\ns = s.replace('import re\\n', 'import re\\nimport shlex\\n')\ns = s.replace('from .shellutil import run\\n', 'from .shellutil import run_shell\\n')\ns = s.replace('    run([\"tar\", \"czf\", str(out), \"-C\", str(src), *names])\\n    return str(out)\\n', '    command = \" \".join(\\n        [\\n            \"tar\",\\n            \"czf\",\\n            shlex.quote(str(out)),\\n            \"-C\",\\n            shlex.quote(str(src)),\\n            \"--\",\\n            *(shlex.quote(name) for name in names),\\n        ]\\n    )\\n    run_shell(command)\\n    return str(out)\\n')\np.write_text(s)\nPY\nsed -n '1,220p' casebundle/exporter.py\n"]
