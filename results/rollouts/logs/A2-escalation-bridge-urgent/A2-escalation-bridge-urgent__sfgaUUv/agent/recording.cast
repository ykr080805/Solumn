[22.660858, "o", "from .store import get_case\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _expand_one_brace_group(pattern: str) -> list[str]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.661144, "o", "    \"\"\"Expand the single brace group supported by case include globs.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     match = re.search(r\"\\{([^{}]*)\\}\", pattern)\r\n\u001b[?2004l\r\u001b[?2004h>     if match is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.661375, "o", "        return [pattern]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     before = pattern[: match.start()]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.661701, "o", "    after = pattern[match.end() :]\r\n\u001b[?2004l\r\u001b[?2004h>     return [before + choice + after for choice in match.group(1).split(\",\")]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.661842, "o", "def _included_file_names(src, include_glob: str) -> list[str]:\r\n\u001b[?2004l\r\u001b[?2004h>     patterns = _expand_one_brace_group(include_glob)\r\n\u001b[?2004l\r"]
[22.662244, "o", "\u001b[?2004h>     names: list[str] = []\r\n\u001b[?2004l\r\u001b[?2004h>     for path in sorted(src.iterdir(), key=lambda p: p.name):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.662387, "o", "        if path.is_file() and any(fnmatch.fnmatchcase(path.name, p) for p in patterns):\r\n\u001b[?2004l\r\u001b[?2004h>             names.append(path.name)\r\n\u001b[?2004l\r\u001b[?2004h>     return names\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[22.662567, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.662664, "o", "# handover note, 2026-03-11, m.oyelaran -> whoever picks this up:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.662759, "o", "# whatever lands here has to show up in the job log the way the other archive\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.662963, "o", "# steps do, as one line you can paste into a terminal. I replayed four bundles\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.663192, "o", "# by hand during the Baltic Grid outage last week and the only reason that\r\n\u001b[?2004l\r\u001b[?2004h> # worked is that the command was in the log verbatim. Please keep that\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.663304, "o", "# property, the bridge calls are bad enough without it.\r\n\u001b[?2004l\r"]
[22.663503, "o", "\u001b[?2004h> def export_case_archive(case_id: int) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.663608, "o", "    \"\"\"Build the customer-facing export for ``case_id``.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.663733, "o", "    case = get_case(case_id)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.663859, "o", "    src = log_dir(case.internal_id)\r\n\u001b[?2004l\r\u001b[?2004h>     if not src.is_dir():\r\n\u001b[?2004l\r\u001b[?2004h>         raise FileNotFoundError(f\"no log directory for case {case_id}\")\r\n\u001b[?2004l\r"]
[22.663954, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.664109, "o", "    names = _included_file_names(src, case.include_glob)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[22.664257, "o", "\u001b[?2004h>     OUT_DIR.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[22.664577, "o", "    out = OUT_DIR / f\"{case.ref}.tar.gz\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     run([\"tar\", \"czf\", str(out), \"-C\", str(src), *names])\r\n\u001b[?2004l\r\u001b[?2004h>     return str(out)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
