[103.096995, "i", "cat > casebundle/exporter.py <<'PY'\n\"\"\"Customer-facing exports.\n\nAn export is the subset of a case's logs that we are willing to hand back to\nthe account, named by the CRM reference so that support can attach it to the\nticket without renaming anything.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport fnmatch\nimport tarfile\nfrom pathlib import Path\n\nfrom .paths import OUT_DIR, log_dir\nfrom .store import get_case\n\n\ndef _expand_brace_group(pattern: str) -> list[str]:\n    \"\"\"Expand the single CRM-supported brace group in ``pattern``.\n\n    Bash-style globbing treats ``{app,pump}.log`` as two patterns,\n    ``app.log`` and ``pump.log``.  The CRM only sends at most one brace group;\n    if there is no complete group, leave the pattern unchanged.\n    \"\"\"\n    start = pattern.find(\"{\")\n    if start == -1:\n        return [pattern]\n\n    end = pattern.find(\"}\", start + 1)\n    if end == -1:\n        return [pattern]\n\n    prefix = pattern[:start]\n    suffix = pattern[end + 1 :]\n    return [f\"{prefix}{part}{suffix}\" for part in "]
[103.097351, "i", "pattern[start + 1 : end].split(\",\")]\n\n\ndef _matching_top_level_files(directory: Path, include_glob: str) -> list[Path]:\n    patterns = _expand_brace_group(include_glob)\n    return sorted(\n        (\n            path\n            for path in directory.iterdir()\n            if path.is_file()\n            and any(fnmatch.fnmatchcase(path.name, pattern) for pattern in patterns)\n        ),\n        key=lambda path: path.name,\n    )\n\n\ndef export_case_archive(case_id: int) -> str:\n    \"\"\"Build the customer-facing export for ``case_id``.\n\n    The archive is named by the customer-facing CRM reference and contains only\n    top-level files from the case log directory whose file names match the\n    case's include glob.  Archive members are stored without any leading\n    directory component so support can unpack the archive directly into a\n    folder.\n    \"\"\"\n    case = get_case(case_id)\n    src = log_dir(case.internal_id)\n    if not src.is_dir():\n        raise FileNotFoundError(f\"no log directory for case {case_id}\")\n\n    OU"]
[103.097379, "o", "cat > casebundle/exporter.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"Customer-facing exports.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[103.097384, "i", "T_DIR.mkdir(parents=True, exist_ok=True)\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\n\n    with tarfile.open(out, \"w:gz\") as archive:\n        for path in _matching_top_level_files(src, case.include_glob):\n            archive.add(path, arcname=path.name)\n\n    return str(out)\nPY\n"]
[103.09762, "o", "An export is the subset of a case's logs that we are willing to hand back to\r\n\u001b[?2004l\r\u001b[?2004h> the account, named by the CRM reference so that support can attach it to the\r\n\u001b[?2004l\rpattern[start + 1 : end].split(\",\")]\r\n\r\n\r\ndef _matching_top_level_files(directory: Path, include_glob: str) -> list[Path]:\r\n    patterns = _expand_brace_group(include_glob)\r\n    return sorted(\r\n        (\r\n            path\r\n            for path in directory.iterdir()\r\n            if path.is_file()\r\n            and any(fnmatch.fnmatchcase(path.name, pattern) for pattern in patterns)\r\n        ),\r\n        key=lambda path: path.name,\r\n    )\r\n\r\n\r\ndef export_case_archive(case_id: int) -> str:\r\n    \"\"\"Build the customer-facing export for ``case_id``.\r\n\r\n    The archive is named by the customer-facing CRM reference and contains only\r\n    top-level files from the case log directory whose file names match the\r\n    case's include glob.  Archive members are stored without any leading\r\n    directory component so support can unpack the archive"]
[103.09766, "o", " directly into a\r\n    folder.\r\n    \"\"\"\r\n    case = get_case(case_id)\r\n    src = log_dir(case.internal_id)\r\n    if not src.is_dir():\r\n        raise FileNotFoundError(f\"no log directory for case {case_id}\")\r\n\r\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\r\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\r\n\r\n    with tarfile.open(out, \"w:gz\") as archive:\r\n        for path in _matching_top_level_files(src, case.include_glob):\r\n            archive.add(path, arcname=path.name)\r\n\r\n    return str(out)\r\nPY\r\n\u001b[?2004h> ticket without renaming anything.\r\n\u001b[?2004l\r\u001b[?2004h"]
