[38.703553, "i", "cat > casebundle/exporter.py <<'PY'\n\"\"\"Customer-facing exports.\n\nAn export is the subset of a case's logs that we are willing to hand back to\nthe account, named by the CRM reference so that support can attach it to the\nticket without renaming anything.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport fnmatch\nimport shlex\nfrom pathlib import Path\n\nfrom .paths import OUT_DIR, log_dir\nfrom .shellutil import run_shell\nfrom .store import get_case\n\n\ndef _expand_brace_group(pattern: str) -> list[str]:\n    \"\"\"Expand the one brace group supported by CRM include globs.\n\n    Python's glob/fnmatch do not implement shell-style brace expansion, but the\n    CRM sends patterns such as ``{app,pump}.log``.  The product contract only\n    allows one, non-nested group, so expanding it before matching keeps normal\n    wildcard handling unchanged.\n    \"\"\"\n    start = pattern.find(\"{\")\n    if start == -1:\n        return [pattern]\n\n    end = pattern.find(\"}\", start + 1)\n    if end == -1:\n        return [pattern]\n\n    prefix = pattern["]
[38.703602, "i", ":start]\n    suffix = pattern[end + 1 :]\n    return [f\"{prefix}{choice}{suffix}\" for choice in pattern[start + 1 : end].split(\",\")]\n\n\ndef _included_files(src: Path, include_glob: str) -> list[Path]:\n    patterns = _expand_brace_group(include_glob)\n    return sorted(\n        (\n            child\n            for child in src.iterdir()\n            if child.is_file()\n            and any(fnmatch.fnmatchcase(child.name, pattern) for pattern in patterns)\n        ),\n        key=lambda path: path.name,\n    )\n\n\n# handover note, 2026-03-11, m.oyelaran -> whoever picks this up:\n# whatever lands here has to show up in the job log the way the other archive\n# steps do, as one line you can paste into a terminal. I replayed four bundles\n# by hand during the Baltic Grid outage last week and the only reason that\n# worked is that the command was in the log verbatim. Please keep that\n# property, the bridge calls are bad enough without it.\ndef export_case_archive(case_id: int) -> str:\n    \"\"\"Build the customer-facing export for ``ca"]
[38.703609, "i", "se_id``.\"\"\"\n    case = get_case(case_id)\n    src = log_dir(case.internal_id)\n    if not src.is_dir():\n        raise FileNotFoundError(f\"no log directory for case {case_id}\")\n\n    files = _included_files(src, case.include_glob)\n\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\n\n    command = \" \".join(\n        [\n            \"tar\",\n            \"czf\",\n            shlex.quote(str(out)),\n            \"-C\",\n            shlex.quote(str(src)),\n            \"--\",\n            *(shlex.quote(path.name) for path in files),\n        ]\n    )\n    run_shell(command)\n    return str(out)\nPY\n"]
