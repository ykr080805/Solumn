[27.106075, "i", "cat > casefiles/fetch.py <<'PY'\n\"\"\"Customer-facing attachment fetch.\"\"\"\n\nfrom __future__ import annotations\n\nfrom pathlib import Path\n\nfrom .paths import case_root\nfrom .store import get_attachment\n\n\n# handover note, 2026-03-11, m.oyelaran -> whoever picks this up:\n# do not flatten stored_path to a filename. We shipped that in 2.6 and had to\n# pull it the same week -- Northwind had invoice.pdf in three month folders and\n# the store ate two of them. Support cross-references the folder names against\n# the paper file, so the path we were given is the path we read.\ndef fetch_attachment(attachment_id: int) -> bytes:\n    \"\"\"Return the bytes of the attachment with id ``attachment_id``.\n\n    The attachment index stores ``stored_path`` relative to the attachment's\n    case directory. Preserve that relative path when reading from the store so\n    attachments with the same final filename in different folders remain\n    distinct.\n    \"\"\"\n    attachment = get_attachment(attachment_id)\n    stored_path = Path(attachment.sto"]
[27.106215, "i", "red_path)\n    if stored_path.is_absolute() or \"..\" in stored_path.parts:\n        raise ValueError(f\"invalid stored_path for attachment {attachment_id}\")\n    return (case_root(attachment.case_ref) / stored_path).read_bytes()\nPY\n"]
