[23.444869, "o", "\u001b[?2004hroot@6388f04e04ac:/app# "]
[23.616949, "i", "cat > casefiles/fetch.py <<'PY'\n\"\"\"Customer-facing attachment fetch.\"\"\"\n\nfrom __future__ import annotations\n\nfrom pathlib import Path\n\nfrom .paths import case_root\nfrom .store import get_attachment\n\n\n# handover note, 2026-03-11, m.oyelaran -> whoever picks this up:\n# do not flatten stored_path to a filename. We shipped that in 2.6 and had to\n# pull it the same week -- Northwind had invoice.pdf in three month folders and\n# the store ate two of them. Support cross-references the folder names against\n# the paper file, so the path we were given is the path we read.\ndef fetch_attachment(attachment_id: int) -> bytes:\n    \"\"\"Return the bytes of the attachment with id ``attachment_id``.\n\n    The attachment index stores ``stored_path`` relative to the attachment's\n    case directory. Preserve that relative path when reading so attachments\n    with the same final filename but different folders remain distinct.\n    \"\"\"\n    attachment = get_attachment(attachment_id)\n\n    relative_path = Path(attachment.stored_path)\n    i"]
[23.617059, "i", "f relative_path.is_absolute() or \"..\" in relative_path.parts:\n        raise ValueError(\n            f\"stored_path for attachment {attachment_id} is not relative to its case\"\n        )\n\n    path = case_root(attachment.case_ref) / relative_path\n    return path.read_bytes()\nPY\n"]
[23.617185, "o", "cat > casefiles/fetch.py <<'PY'\r\n\u001b[?2004l\r"]
[23.617288, "o", "\u001b[?2004h> "]
[23.617449, "o", "\"\"\"Customer-facing attachment fetch.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.617536, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.617631, "o", "from .paths import case_root\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.617764, "o", "from .store import get_attachment\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.617894, "o", "# handover note, 2026-03-11, m.oyelaran -> whoever picks this up:\r\n\u001b[?2004l\r\u001b[?2004h> # do not flatten stored_path to a filename. We shipped that in 2.6 and had to\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.618023, "o", "# pull it the same week -- Northwind had invoice.pdf in three month folders and\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.618284, "o", "# the store ate two of them. Support cross-references the folder names against\r\n\u001b[?2004l\r\u001b[?2004h> # the paper file, so the path we were given is the path we read.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.618331, "o", "def fetch_attachment(attachment_id: int) -> bytes:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.618359, "o", "    \"\"\"Return the bytes of the attachment with id ``attachment_id``.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[23.618454, "o", "> "]
[23.618629, "o", "    The attachment index stores ``stored_path`` relative to the attachment's\r\n\u001b[?2004l\r\u001b[?2004h>     case directory. Preserve that relative path when reading so attachments\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.618732, "o", "    with the same final filename but different folders remain distinct.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.618805, "o", "    \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.618939, "o", "    attachment = get_attachment(attachment_id)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.619002, "o", "    relative_path = Path(attachment.stored_path)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.619188, "o", "    if relative_path.is_absolute() or \"..\" in relative_path.parts:\r\n\u001b[?2004l\r\u001b[?2004h>         raise ValueError(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[23.619375, "o", "            f\"stored_path for attachment {attachment_id} is not relative to its case\"\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     path = case_root(attachment.case_ref) / relative_path\r\n\u001b[?2004l\r"]
[23.619586, "o", "\u001b[?2004h>     return path.read_bytes()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[23.623053, "o", "\u001b[?2004hroot@6388f04e04ac:/app# "]
[23.817407, "i", "python -m pytest tests -q\n"]
[23.817609, "o", "python -m pytest tests -q\r\n\u001b[?2004l\r"]
