[34.754992, "i", "python - <<'PY'\nfrom casefiles.fetch import fetch_attachment\nfrom casefiles.store import AttachmentNotFound\n\ntry:\n    fetch_attachment(9999)\nexcept AttachmentNotFound as exc:\n    print(type(exc).__name__)\nelse:\n    raise SystemExit('missing attachment did not raise')\nPY\n"]
[34.755134, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[34.755271, "o", "\u001b[?2004h> from casefiles.fetch import fetch_attachment\r\n\u001b[?2004l\r\u001b[?2004h> from casefiles.store import AttachmentNotFound\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> try:\r\n\u001b[?2004l\r\u001b[?2004h>     fetch_attachment(9999)\r\n\u001b[?2004l\r"]
[34.755298, "o", "\u001b[?2004h> "]
[34.755387, "o", "except AttachmentNotFound as exc:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.755464, "o", "    print(type(exc).__name__)\r\n"]
[34.755529, "o", "\u001b[?2004l\r"]
[34.755586, "o", "\u001b[?2004h> else:\r\n\u001b[?2004l\r"]
[34.755615, "o", "\u001b[?2004h> "]
[34.755762, "o", "    raise SystemExit('missing attachment did not raise')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[34.88383, "o", "AttachmentNotFound\r\n"]
