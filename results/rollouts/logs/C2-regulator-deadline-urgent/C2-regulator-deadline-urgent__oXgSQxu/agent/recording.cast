[34.928208, "o", "> except FileNotFoundError as exc:\r\n\u001b[?2004l\r\u001b[?2004h>     print(type(exc).__name__)\r\n\u001b[?2004l\r\u001b[?2004h> else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
