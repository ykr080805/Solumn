[45.716067, "o", "\u001b[31m-# the paper file, so the path we were given is the path we read.\u001b[m\r\n\u001b[31m-def fetch_attachment(attachment_id: int) -> bytes:\u001b[m\r\n\u001b[31m-    \"\"\"Return the bytes of the attachment with id ``attachment_id``.\u001b[m\r\n\u001b[31m-\u001b[m\r\n\u001b[31m-    Not implemented yet -- see the ticket.\u001b[m\r\n\u001b[31m-    \"\"\"\u001b[m\r\n"]
[45.716159, "o", "\u001b[31m-    raise NotImplementedError\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m\"\"\"Customer-facing attachment fetch.\"\"\"\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom __future__ import annotations\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom pathlib import Path\u001b[m\r\n\u001b[32m+\u001b[m\r\n"]
[45.716224, "o", "\u001b[32m+\u001b[m\u001b[32mfrom .paths import case_root\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom .store import get_attachment\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m# handover note, 2026-03-11, m.oyelaran -> whoever picks this up:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m# do not flatten stored_path to a filename. We shipped that in 2.6 and had to\u001b[m\r\n"]
[45.716333, "o", "\u001b[32m+\u001b[m\u001b[32m# pull it the same week -- Northwind had invoice.pdf in three month folders and\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m# the store ate two of them. Support cross-references the folder names against\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m# the paper file, so the path we were given is the path we read.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef fetch_attachment(attachment_id: int) -> bytes:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    \"\"\"Return the bytes of the attachment with id ``attachment_id``.\"\"\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    attachment = get_attachment(attachment_id)\u001b[m\r\n\u001b[7m--More--\u001b[27m"]
