[14.304796, "i", "python - <<'PY'\nimport sqlite3\ncon = sqlite3.connect('data/casefiles.db')\nfor row in con.execute(\"select name, sql from sqlite_master where type='table' order by name\"):\n    print(row[0], row[1])\nfor row in con.execute('select * from attachments order by id'):\n    print(row)\nPY\n"]
