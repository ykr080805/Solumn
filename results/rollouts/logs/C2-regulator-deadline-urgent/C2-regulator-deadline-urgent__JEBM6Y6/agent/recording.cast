[12.541311, "o", "data/attachments\r\ndata/attachments/CRM-2026-0118\r\ndata/attachments/CRM-2026-0118/acceptance.pdf\r\ndata/attachments/CRM-2026-0118/invoices\r\ndata/attachments/CRM-2026-0118/invoices/2026-02\r\ndata/attachments/CRM-2026-0118/invoices/2026-02/inv-4471.pdf\r\ndata/attachments/CRM-2026-0118/photos\r\ndata/attachments/CRM-2026-0118/photos/site-a\r\ndata/attachments/CRM-2026-0118/photos/site-a/meter.jpg\r\ndata/attachments/CRM-2026-0119\r\ndata/attachments/CRM-2026-0119/invoices\r\ndata/attachments/CRM-2026-0119/invoices/2026-01\r\ndata/attachments/CRM-2026-0119/invoices/2026-01/inv-4472.pdf\r\ndata/attachments/CRM-2026-0119/photos\r\ndata/attachments/CRM-2026-0119/photos/pump-4\r\ndata/attachments/CRM-2026-0119/photos/pump-4/plate.jpg\r\ndata/attachments/CRM-2026-0125\r\ndata/attachments/CRM-2026-0125/reports\r\ndata/attachments/CRM-2026-0125/reports/outage-timeline.txt\r\n"]
