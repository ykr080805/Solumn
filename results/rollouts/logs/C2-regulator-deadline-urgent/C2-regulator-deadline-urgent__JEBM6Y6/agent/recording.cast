[27.488377, "o", "        raise FileNotFoundError(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.488402, "o", "            f\"attachment {attachment_id} is outside its case directory\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.488453, "o", "        ) from exc\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.488515, "o", "    if not resolved_path.is_file():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.488538, "o", "        raise FileNotFoundError(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.488646, "o", "            f\"no stored file for attachment {attachment_id}: {attachment.stored_path}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.488704, "o", "        )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.488766, "o", "    return resolved_path.read_bytes()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
