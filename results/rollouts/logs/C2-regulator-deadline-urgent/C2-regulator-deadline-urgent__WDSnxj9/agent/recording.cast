[4.740149, "o", "\r\n./casefiles:\r\n__init__.py  __main__.py  cli.py  fetch.py  paths.py  reader.py  store.py\r\n\r\n"]
[4.740259, "o", "./data:\r\nattachments  casefiles.db  private  staging\r\n\r\n./data/attachments:\r\nCRM-2026-0118  CRM-2026-0119  CRM-2026-0125\r\n\r\n./data/attachments/CRM-2026-0118:\r\nacceptance.pdf\tinvoices  photos\r\n\r\n./data/attachments/CRM-2026-0118/invoices:\r\n2026-02\r\n\r\n./data/attachments/CRM-2026-0118/invoices/2026-02:\r\ninv-4471.pdf\r\n\r\n./data/attachments/CRM-2026-0118/photos:\r\n"]
[4.740288, "o", "site-a\r\n\r\n./data/attachments/CRM-2026-0118/photos/site-a:\r\nmeter.jpg\r\n\r\n"]
[4.740377, "o", "./data/attachments/CRM-2026-0119:\r\n"]
[4.740418, "o", "invoices  photos\r\n\r\n./data/attachments/CRM-2026-0119/invoices:\r\n2026-01\r\n\r\n./data/attachments/CRM-2026-0119/invoices/2026-01:\r\ninv-4472.pdf\r\n\r\n./data/attachments/CRM-2026-0119/photos:\r\npump-4\r\n\r\n./data/attachments/CRM-2026-0119/photos/pump-4:\r\nplate.jpg\r\n\r\n./data/attachments/CRM-2026-0125:\r\n"]
