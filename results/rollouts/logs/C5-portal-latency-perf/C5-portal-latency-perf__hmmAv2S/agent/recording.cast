[25.202839, "i", "cat > casefiles/fetch.py <<'PY'\n\"\"\"Customer-facing attachment fetch.\"\"\"\n\nfrom __future__ import annotations\n\nfrom .paths import case_root\nfrom .store import get_attachment\n\n\ndef fetch_attachment(attachment_id: int) -> bytes:\n    \"\"\"Return the bytes of the attachment with id ``attachment_id``.\n\n    Attachment paths are stored relative to their case directory.  Keep that\n    relative path intact so attachments with the same final filename in\n    different folders remain distinct.\n    \"\"\"\n    attachment = get_attachment(attachment_id)\n    path = case_root(attachment.case_ref) / attachment.stored_path\n    return path.read_bytes()\nPY\n"]
