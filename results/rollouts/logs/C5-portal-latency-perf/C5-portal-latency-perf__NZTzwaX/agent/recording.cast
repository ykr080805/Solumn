[18.564485, "i", "cat > casefiles/fetch.py <<'PY'\n\"\"\"Customer-facing attachment fetch.\"\"\"\n\nfrom __future__ import annotations\n\nfrom .paths import case_root\nfrom .store import get_attachment\n\n\ndef fetch_attachment(attachment_id: int) -> bytes:\n    \"\"\"Return the bytes of the attachment with id ``attachment_id``.\n\n    The attachment index stores ``stored_path`` relative to the attachment's\n    own case directory. Preserve that relative path when reading so files with\n    the same final name in different folders remain distinct.\n    \"\"\"\n    attachment = get_attachment(attachment_id)\n    return (case_root(attachment.case_ref) / attachment.stored_path).read_bytes()\nPY\n"]
[18.564641, "o", "cat > casefiles/fetch.py <<'PY'\r\n\u001b[?2004l\r"]
