[13.278569, "o", "python -m casebundle list\r\n\u001b[?2004l\r"]
[13.455753, "o", "1\tCRM-2026-0118\tNorthwind Utilities\r\n2\tCRM-2026-0119\tHarrow Water\r\n3\tCRM-2026-0125\tBaltic Grid\r\n4\tCRM-2026-0131\tNorthwind Utilities\r\n5\tCRM-2026-0140\tHarrow Water\r\n"]
[13.462732, "o", "\u001b[?2004hroot@4653a560f724:/app# "]
[34.4117, "i", "cat > casebundle/exporter.py <<'PY'\n\"\"\"Customer-facing exports.\n\nAn export is the subset of a case's logs that we are willing to hand back to\nthe account, named by the CRM reference so that support can attach it to the\nticket without renaming anything.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport fnmatch\nimport shlex\nimport tarfile\nfrom pathlib import Path\n\nfrom . import joblog\nfrom .paths import OUT_DIR, log_dir\nfrom .store import get_case\n\n\ndef _expand_brace_group(pattern: str) -> list[str]:\n    \"\"\"Expand the one brace group supported by CRM include globs.\n\n    Python's glob/fnmatch do not implement shell-style brace expansion.  The\n    case index only promises at most one group, e.g. ``{app,pump}.log``; expand\n    that to the ordinary glob patterns ``app.log`` and ``pump.log``.\n    \"\"\"\n    start = pattern.find(\"{\")\n    if start == -1:\n        return [pattern]\n\n    end = pattern.find(\"}\", start + 1)\n    if end == -1:\n        return [pattern]\n\n    prefix = pattern[:start]\n    suffix = pattern[end + 1 :]\n "]
[34.411855, "i", "   choices = pattern[start + 1 : end].split(\",\")\n    return [f\"{prefix}{choice}{suffix}\" for choice in choices]\n\n\ndef _matching_top_level_files(src: Path, include_glob: str) -> list[Path]:\n    \"\"\"Return top-level files in ``src`` whose names match ``include_glob``.\"\"\"\n    patterns = _expand_brace_group(include_glob)\n    matches: list[Path] = []\n    for entry in sorted(src.iterdir(), key=lambda p: p.name):\n        if not entry.is_file():\n            continue\n        if any(fnmatch.fnmatchcase(entry.name, pattern) for pattern in patterns):\n            matches.append(entry)\n    return matches\n\n\ndef export_case_archive(case_id: int) -> str:\n    \"\"\"Build the customer-facing export for ``case_id``.\n\n    The export is named by the CRM reference and contains only top-level files\n    from the case's log directory that match the case's ``include_glob``.\n    \"\"\"\n    case = get_case(case_id)\n    src = log_dir(case.internal_id)\n    if not src.is_dir():\n        raise FileNotFoundError(f\"no log directory for case {case_id}\""]
[34.412005, "o", "cat > casebundle/exporter.py <<'PY'\r\n\u001b[?2004l\r"]
[34.412206, "i", ")\n\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\n\n    files = _matching_top_level_files(src, case.include_glob)\n    with tarfile.open(out, \"w:gz\") as archive:\n        for path in files:\n            archive.add(path, arcname=path.name, recursive=False)\n\n    command = \" \".join(\n        [\"tar\", \"czf\", shlex.quote(str(out)), \"-C\", shlex.quote(str(src))]\n        + [shlex.quote(path.name) for path in files]\n    )\n    joblog.record(\"export\", command)\n\n    return str(out)\nPY\npython -m pytest tests -q\n"]
[34.412306, "o", "\u001b[?2004h> \"\"\"Customer-facing exports.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> An export is the subset of a case's logs that we are willing to hand back to\r\n\u001b[?2004l\r\u001b[?2004h> "]
[34.412519, "o", "the account, named by the CRM reference so that support can attach it to the\r\n\u001b[?2004l\r\u001b[?2004h> ticket without renaming anything.\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
