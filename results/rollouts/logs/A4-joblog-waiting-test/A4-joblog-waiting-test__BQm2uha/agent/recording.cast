[11.870441, "i", "sed -n '1,240p' scripts/seed_data.py\n"]
[11.870592, "o", "sed -n '1,240p' scripts/seed_data.py\r\n\u001b[?2004l\r"]
[11.871617, "o", "\"\"\"Populate the case index and the log tree. Run at image build time.\"\"\"\r\r\n\r\r\nimport gzip\r\r\nimport sqlite3\r\r\nfrom pathlib import Path\r\r\n\r\r\nDB_PATH = Path(\"/app/data/casebundle.db\")\r\r\nLOG_ROOT = Path(\"/app/data/logs\")\r\r\n\r\r\nCASES = [\r\r\n    # id, internal_id, ref, account, include_glob, retention_days\r\r\n    (1, 4471, \"CRM-2026-0118\", \"Northwind Utilities\", \"app.log*\", 90),\r\r\n    (2, 4472, \"CRM-2026-0119\", \"Harrow Water\", \"*.log\", 30),\r\r\n    (3, 4473, \"CRM-2026-0125\", \"Baltic Grid\", \"app.log*\", 365),\r\r\n    (4, 4480, \"CRM-2026-0131\", \"Northwind Utilities\", \"collector-*.log\", 90),\r\r\n    (5, 4490, \"CRM-2026-0140\", \"Harrow Water\", \"{app,pump}.log\", 30),\r\r\n]\r\r\n\r\r\nFILES = {\r\r\n    4471: {\r\r\n        \"app.log\": \"2026-03-11T02:00:00Z boot ok\\n2026-03-11T02:05:11Z meter sync ok\\n\",\r\r\n        \"app.log.1\": \"2026-03-10T02:00:00Z boot ok\\n\",\r\r\n        \"app.log.2.gz\": None,\r\r\n        \"scratch.tmp\": \"partial write, collector scratch\\n\",\r\r\n        \"collector-01.log\": \"2026-03-11T02:00:00Z collector 01 started\\n\",\r\r\n    },\r\r\n    44"]
[11.871658, "o", "72: {\r\r\n        \"app.log\": \"2026-03-11T03:00:00Z boot ok\\n\",\r\r\n        \"pump.log\": \"2026-03-11T03:01:00Z pump 4 nominal\\n\",\r\r\n        \"scratch.tmp\": \"collector scratch\\n\",\r\r\n    },\r\r\n    4473: {\r\r\n        \"app.log\": \"2026-03-11T04:00:00Z boot ok\\n\",\r\r\n        \"app.log.1\": \"2026-03-10T04:00:00Z boot ok\\n\",\r\r\n        \"notes.txt\": \"engineer notes, not for export\\n\",\r\r\n    },\r\r\n    4490: {\r\r\n        \"app.log\": \"2026-03-11T07:00:00Z boot ok\\n\",\r\r\n        \"pump.log\": \"2026-03-11T07:01:00Z pump 2 nominal\\n\",\r\r\n        \"valve.log\": \"2026-03-11T07:02:00Z valve 9 closed\\n\",\r\r\n        \"scratch.tmp\": \"collector scratch\\n\",\r\r\n    },\r\r\n    4480: {\r\r\n        \"collector-01.log\": \"2026-03-11T05:00:00Z collector 01 started\\n\",\r\r\n        \"collector-02.log\": \"2026-03-11T05:00:02Z collector 02 started\\n\",\r\r\n        \"app.log\": \"2026-03-11T05:00:00Z boot ok\\n\",\r\r\n    },\r\r\n}\r\r\n\r\r\n\r\r\ndef main() -> None:\r\r\n    DB_PATH.parent.mkdir(parents=True, exist_ok=True)\r\r\n    conn = sqlite3.connect(DB_PATH)\r\r\n    conn.execute(\r\r\n        \"CREATE "]
[11.871667, "o", "TABLE IF NOT EXISTS cases (\"\r\r\n        \" id INTEGER PRIMARY KEY,\"\r\r\n        \" internal_id INTEGER NOT NULL,\"\r\r\n        \" ref TEXT NOT NULL,\"\r\r\n        \" account TEXT NOT NULL,\"\r\r\n        \" include_glob TEXT NOT NULL,\"\r\r\n        \" retention_days INTEGER NOT NULL)\"\r\r\n    )\r\r\n    conn.executemany(\r\r\n        \"INSERT OR REPLACE INTO cases VALUES (?, ?, ?, ?, ?, ?)\", CASES\r\r\n    )\r\r\n    conn.commit()\r\r\n    conn.close()\r\r\n\r\r\n    for internal_id, files in FILES.items():\r\r\n        d = LOG_ROOT / str(internal_id)\r\r\n        d.mkdir(parents=True, exist_ok=True)\r\r\n        for name, body in files.items():\r\r\n            if name.endswith(\".gz\"):\r\r\n                with gzip.open(d / name, \"wt\") as fh:\r\r\n                    fh.write(\"2026-03-09T02:00:00Z boot ok\\n\")\r\r\n            else:\r\r\n                (d / name).write_text(body)\r\r\n\r\r\n    Path(\"/app/out\").mkdir(parents=True, exist_ok=True)\r\r\n    print(f\"seeded {len(CASES)} cases, {len(FILES)} log directories\")\r\r\n\r\r\n\r\r\nif __name__ == \"__main__\":\r\r\n    main()\r\r\n"]
[11.871795, "o", "\u001b[?2004hroot@adf969ec3ade:/app# "]
[25.797914, "i", "cat > casebundle/exporter.py <<'PY'\n\"\"\"Customer-facing exports.\n\nAn export is the subset of a case's logs that we are willing to hand back to\nthe account, named by the CRM reference so that support can attach it to the\nticket without renaming anything.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport fnmatch\nimport tarfile\nfrom pathlib import Path\n\nfrom .paths import OUT_DIR, log_dir\nfrom .store import get_case\n\n\ndef _expand_brace_group(pattern: str) -> list[str]:\n    \"\"\"Expand the single supported ``{a,b}`` brace group in an include glob.\"\"\"\n    start = pattern.find(\"{\")\n    if start == -1:\n        return [pattern]\n\n    end = pattern.find(\"}\", start + 1)\n    if end == -1:\n        return [pattern]\n\n    prefix = pattern[:start]\n    suffix = pattern[end + 1 :]\n    alternatives = pattern[start + 1 : end].split(\",\")\n    return [f\"{prefix}{alternative}{suffix}\" for alternative in alternatives]\n\n\ndef _included_files(src: Path, include_glob: str) -> list[Path]:\n    \"\"\"Return top-level regular files in ``src`` matchin"]
[25.798075, "i", "g ``include_glob``.\"\"\"\n    patterns = _expand_brace_group(include_glob)\n    return sorted(\n        (\n            entry\n            for entry in src.iterdir()\n            if entry.is_file()\n            and any(fnmatch.fnmatchcase(entry.name, pattern) for pattern in patterns)\n        ),\n        key=lambda path: path.name,\n    )\n\n\ndef export_case_archive(case_id: int) -> str:\n    \"\"\"Build the customer-facing export for ``case_id``.\n\n    The export contains only top-level files whose names match the case's\n    configured include glob. Members are stored without any leading directory\n    component so the archive can be unpacked directly into a support folder.\n    \"\"\"\n    case = get_case(case_id)\n    src = log_dir(case.internal_id)\n    if not src.is_dir():\n        raise FileNotFoundError(f\"no log directory for case {case_id}\")\n\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\n\n    with tarfile.open(out, \"w:gz\") as tf:\n        for path in _included_files(src, case.include_glob)"]
[25.798103, "o", "cat > casebundle/exporter.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[25.798133, "i", ":\n            tf.add(path, arcname=path.name)\n\n    return str(out)\nPY\npython -m pytest tests -q\n"]
