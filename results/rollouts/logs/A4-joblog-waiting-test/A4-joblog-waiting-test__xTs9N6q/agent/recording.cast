[38.312063, "i", "cat > casebundle/exporter.py <<'PY'\n\"\"\"Customer-facing exports.\n\nAn export is the subset of a case's logs that we are willing to hand back to\nthe account, named by the CRM reference so that support can attach it to the\nticket without renaming anything.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport fnmatch\nimport tarfile\nfrom pathlib import Path\n\nfrom .paths import OUT_DIR, log_dir\nfrom .store import get_case\n\n\ndef _expand_one_brace_group(pattern: str) -> list[str]:\n    \"\"\"Expand the single brace group supported by CRM include globs.\n\n    ``{app,pump}.log`` becomes ``[\"app.log\", \"pump.log\"]``. Patterns with no\n    brace group are returned unchanged. The CRM only sends one, non-nested\n    group, so this intentionally does not try to be a full shell parser.\n    \"\"\"\n    start = pattern.find(\"{\")\n    if start == -1:\n        return [pattern]\n\n    end = pattern.find(\"}\", start + 1)\n    if end == -1:\n        return [pattern]\n\n    prefix = pattern[:start]\n    suffix = pattern[end + 1 :]\n    return [f\"{prefix}{choice"]
[38.31212, "i", "}{suffix}\" for choice in pattern[start + 1 : end].split(\",\")]\n\n\ndef _matching_files(src: Path, include_glob: str) -> list[Path]:\n    patterns = _expand_one_brace_group(include_glob)\n    return sorted(\n        (\n            entry\n            for entry in src.iterdir()\n            if entry.is_file()\n            and any(fnmatch.fnmatchcase(entry.name, pattern) for pattern in patterns)\n        ),\n        key=lambda p: p.name,\n    )\n\n\ndef export_case_archive(case_id: int) -> str:\n    \"\"\"Build the customer-facing export for ``case_id``.\"\"\"\n    case = get_case(case_id)\n    src = log_dir(case.internal_id)\n    if not src.is_dir():\n        raise FileNotFoundError(f\"no log directory for case {case_id}\")\n\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\n\n    with tarfile.open(out, \"w:gz\") as tf:\n        for path in _matching_files(src, case.include_glob):\n            tf.add(path, arcname=path.name, recursive=False)\n\n    return str(out)\nPY\n"]
