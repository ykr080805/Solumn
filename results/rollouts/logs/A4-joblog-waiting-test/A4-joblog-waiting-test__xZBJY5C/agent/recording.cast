[15.923748, "o", "\u001b[?2004hroot@23bc41995483:/app# "]
[35.878767, "i", "cat > casebundle/exporter.py <<'PY'\n\"\"\"Customer-facing exports.\n\nAn export is the subset of a case's logs that we are willing to hand back to\nthe account, named by the CRM reference so that support can attach it to the\nticket without renaming anything.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport fnmatch\nimport shlex\nimport tarfile\n\nfrom . import joblog\nfrom .paths import OUT_DIR, log_dir\nfrom .store import get_case\n\n\ndef _expand_brace_group(pattern: str) -> list[str]:\n    \"\"\"Expand the single supported ``{a,b}`` brace group in ``pattern``.\n\n    ``pathlib``/``fnmatch`` do not implement shell-style brace expansion, but\n    the CRM include glob may contain one group such as ``{app,pump}.log``.\n    Patterns without a brace group are returned unchanged.\n    \"\"\"\n    start = pattern.find(\"{\")\n    if start == -1:\n        return [pattern]\n\n    end = pattern.find(\"}\", start + 1)\n    if end == -1:\n        return [pattern]\n\n    prefix = pattern[:start]\n    suffix = pattern[end + 1 :]\n    return [f\"{prefix}{part}{suff"]
[35.878965, "i", "ix}\" for part in pattern[start + 1 : end].split(\",\")]\n\n\ndef export_case_archive(case_id: int) -> str:\n    \"\"\"Build the customer-facing export for ``case_id``.\n\n    The archive is named by the case's CRM reference and contains only the\n    top-level files whose names match the case's ``include_glob``.  Members are\n    stored without a leading directory component so the archive can be unpacked\n    directly into a folder for the customer.\n    \"\"\"\n    case = get_case(case_id)\n    src = log_dir(case.internal_id)\n    if not src.is_dir():\n        raise FileNotFoundError(f\"no log directory for case {case_id}\")\n\n    patterns = _expand_brace_group(case.include_glob)\n    files = sorted(\n        (\n            path\n            for path in src.iterdir()\n            if path.is_file()\n            and any(fnmatch.fnmatchcase(path.name, pattern) for pattern in patterns)\n        ),\n        key=lambda path: path.name,\n    )\n\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\n\n    with tarfile"]
[35.879219, "o", "cat > casebundle/exporter.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.879344, "i", ".open(out, \"w:gz\") as archive:\n        for path in files:\n            archive.add(path, arcname=path.name)\n\n    joblog.record(\n        \"export\",\n        shlex.join([\"tar\", \"czf\", str(out), \"-C\", str(src), *(p.name for p in files)]),\n    )\n    return str(out)\nPY\n"]
[35.879585, "o", "\"\"\"Customer-facing exports.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> An export is the subset of a case's logs that we are willing to hand back to\r\n\u001b[?2004l\r\u001b[?2004h> the account, named by the CRM reference so that support can attach it to the\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.879715, "o", "ticket without renaming anything.\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from __future__ import annotations\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import fnmatch\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.879747, "o", "> import shlex\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.880096, "o", "import tarfile\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from . import joblog\r\n\u001b[?2004l\r\u001b[?2004h> from .paths import OUT_DIR, log_dir\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.880307, "o", "> from .store import get_case\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def _expand_brace_group(pattern: str) -> list[str]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.880617, "o", "    \"\"\"Expand the single supported ``{a,b}`` brace group in ``pattern``.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     ``pathlib``/``fnmatch`` do not implement shell-style brace expansion, but\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.880932, "o", "    the CRM include glob may contain one group such as ``{app,pump}.log``.\r\n\u001b[?2004l\r\u001b[?2004h>     Patterns without a brace group are returned unchanged.\r\n\u001b[?2004l\r"]
[35.88115, "o", "\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     start = pattern.find(\"{\")\r\n\u001b[?2004l\r\u001b[?2004h>     if start == -1:\r\n\u001b[?2004l\r"]
[35.881422, "o", "\u001b[?2004h>         return [pattern]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     end = pattern.find(\"}\", start + 1)\r\n\u001b[?2004l\r\u001b[?2004h>     if end == -1:\r\n\u001b[?2004l\r\u001b[?2004h>         return [pattern]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.881676, "o", "    prefix = pattern[:start]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.882031, "o", "    suffix = pattern[end + 1 :]\r\n\u001b[?2004l\r\u001b[?2004h>     return [f\"{prefix}{part}{suffix}\" for part in pattern[start + 1 : end].split(\",\")]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[35.882149, "o", "\u001b[?2004h> def export_case_archive(case_id: int) -> str:\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"Build the customer-facing export for ``case_id``.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.882322, "o", "    The archive is named by the case's CRM reference and contains only the\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.882679, "o", "    top-level files whose names match the case's ``include_glob``.  Members are\r\n\u001b[?2004l\r\u001b[?2004h>     stored without a leading directory component so the archive can be unpacked\r\n\u001b[?2004l\r\u001b[?2004h>     directly into a folder for the customer.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.883111, "o", "    case = get_case(case_id)\r\n\u001b[?2004l\r\u001b[?2004h>     src = log_dir(case.internal_id)\r\n\u001b[?2004l\r\u001b[?2004h>     if not src.is_dir():\r\n\u001b[?2004l\r\u001b[?2004h>         raise FileNotFoundError(f\"no log directory for case {case_id}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.883429, "o", "    patterns = _expand_brace_group(case.include_glob)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.883538, "o", "    files = sorted(\r\n\u001b[?2004l\r\u001b[?2004h>         (\r\n\u001b[?2004l\r\u001b[?2004h>             path\r\n\u001b[?2004l\r\u001b[?2004h>             for path in src.iterdir()\r\n\u001b[?2004l\r\u001b[?2004h>             if path.is_file()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.88384, "o", "            and any(fnmatch.fnmatchcase(path.name, pattern) for pattern in patterns)\r\n\u001b[?2004l\r\u001b[?2004h>         ),\r\n\u001b[?2004l\r\u001b[?2004h>         key=lambda path: path.name,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.883896, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.884043, "o", "    OUT_DIR.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.884099, "o", "    out = OUT_DIR / f\"{case.ref}.tar.gz\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[35.884129, "o", "> "]
[35.884313, "o", "    with tarfile.open(out, \"w:gz\") as archive:\r\n\u001b[?2004l\r\u001b[?2004h>         for path in files:\r\n"]
[35.884524, "o", "\u001b[?2004l\r\u001b[?2004h>             archive.add(path, arcname=path.name)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     joblog.record(\r\n\u001b[?2004l\r"]
[35.884614, "o", "\u001b[?2004h>         \"export\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.884752, "o", "        shlex.join([\"tar\", \"czf\", str(out), \"-C\", str(src), *(p.name for p in files)]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[35.8848, "o", ">     )\r\n\u001b[?2004l\r"]
[35.884937, "o", "\u001b[?2004h>     return str(out)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[35.884979, "o", "PY\r\n\u001b[?2004l\r"]
[35.886972, "o", "\u001b[?2004hroot@23bc41995483:/app# "]
[36.101271, "i", "python -m casebundle export 2 && python -m casebundle export 4 && python -m casebundle export 5\n"]
[36.101547, "o", "python -m casebundle export 2 && python -m casebundle export 4 && python -m casebundle export 5\r\n\u001b[?2004l\r"]
