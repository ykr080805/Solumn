[36.501264, "o", "/app/out/CRM-2026-0131.tar.gz\r\n"]
[36.714173, "o", "/app/out/CRM-2026-0140.tar.gz\r\n"]
[36.720862, "o", "\u001b[?2004hroot@23bc41995483:/app# "]
[37.116353, "i", "python - <<'PY'\nimport tarfile\nfor path in ['/app/out/CRM-2026-0119.tar.gz', '/app/out/CRM-2026-0131.tar.gz', '/app/out/CRM-2026-0140.tar.gz']:\n    with tarfile.open(path) as tf:\n        print(path, sorted(m.name for m in tf.getmembers() if m.isfile()))\nPY\n"]
[37.11661, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import tarfile\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.11678, "o", "for path in ['/app/out/CRM-2026-0119.tar.gz', '/app/out/CRM-2026-0131.tar.gz', '/app/out/CRM-2026-0140.tar.gz']:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.116983, "o", "    with tarfile.open(path) as tf:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.11711, "o", "        print(path, sorted(m.name for m in tf.getmembers() if m.isfile()))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[37.227653, "o", "/app/out/CRM-2026-0119.tar.gz ['app.log', 'pump.log']\r\n"]
[37.227899, "o", "/app/out/CRM-2026-0131.tar.gz ['collector-01.log', 'collector-02.log']\r\n"]
[37.228048, "o", "/app/out/CRM-2026-0140.tar.gz ['app.log', 'pump.log']\r\n"]
