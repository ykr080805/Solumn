[36.453441, "o", "\u001b[?2004l\r"]
[36.593821, "o", "Case(id=1, internal_id=4471, ref='CRM-2026-0118', account='Northwind Utilities', include_glob='app.log*', retention_days=90)\r\nCase(id=2, internal_id=4472, ref='CRM-2026-0119', account='Harrow Water', include_glob='*.log', retention_days=30)\r\nCase(id=3, internal_id=4473, ref='CRM-2026-0125', account='Baltic Grid', include_glob='app.log*', retention_days=365)\r\nCase(id=4, internal_id=4480, ref='CRM-2026-0131', account='Northwind Utilities', include_glob='collector-*.log', retention_days=90)\r\nCase(id=5, internal_id=4490, ref='CRM-2026-0140', account='Harrow Water', include_glob='{app,pump}.log', retention_days=30)\r\n"]
[36.599402, "o", "\u001b[?2004hroot@38d7b6fc545f:/app# "]
[36.627218, "i", "cat > casebundle/exporter.py <<'PY'\n\"\"\"Customer-facing exports.\n\nAn export is the subset of a case's logs that we are willing to hand back to\nthe account, named by the CRM reference so that support can attach it to the\nticket without renaming anything.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport fnmatch\nimport tarfile\nfrom pathlib import Path\n\nfrom .paths import OUT_DIR, log_dir\nfrom .store import get_case\n\n\ndef _expand_brace_group(pattern: str) -> list[str]:\n    \"\"\"Return glob patterns after expanding one ``{a,b}`` brace group.\n\n    The CRM only sends one brace group for this field.  Python's glob/fnmatch\n    do not implement Bash-style brace expansion, so handle that small piece\n    here before applying the ordinary wildcard rules.\n    \"\"\"\n    start = pattern.find(\"{\")\n    if start == -1:\n        return [pattern]\n\n    end = pattern.find(\"}\", start + 1)\n    if end == -1:\n        return [pattern]\n\n    prefix = pattern[:start]\n    suffix = pattern[end + 1 :]\n    return [f\"{prefix}{part}{suffix}\" for part i"]
[36.627258, "i", "n pattern[start + 1 : end].split(\",\")]\n\n\ndef _matching_files(src: Path, include_glob: str) -> list[Path]:\n    \"\"\"Select top-level regular files in ``src`` matching ``include_glob``.\"\"\"\n    patterns = _expand_brace_group(include_glob)\n    matches: list[Path] = []\n    seen: set[Path] = set()\n\n    for entry in sorted(src.iterdir(), key=lambda p: p.name):\n        if not entry.is_file():\n            continue\n        if any(fnmatch.fnmatchcase(entry.name, pattern) for pattern in patterns):\n            if entry not in seen:\n                matches.append(entry)\n                seen.add(entry)\n\n    return matches\n\n\ndef export_case_archive(case_id: int) -> str:\n    \"\"\"Build the customer-facing export for ``case_id``.\"\"\"\n    case = get_case(case_id)\n    src = log_dir(case.internal_id)\n    if not src.is_dir():\n        raise FileNotFoundError(f\"no log directory for case {case_id}\")\n\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\n\n    with tarfile.open(out, \"w:gz\") as tf:\n        f"]
[36.627347, "i", "or path in _matching_files(src, case.include_glob):\n            tf.add(path, arcname=path.name)\n\n    return str(out)\nPY\n"]
