[75.247873, "o", "\u001b[33m======================================================================= warnings summary =======================================================================\u001b[0m\r\ntests/test_bundler.py::test_bundle_contents_survive_a_round_trip\r\n  /app/tests/test_bundler.py:32: DeprecationWarning: Python 3.14 will, by default, filter extracted tar archives and reject files or modify their metadata. Use the filter argument to control this behavior.\r\n    tf.extractall(tmp_path)\r\n\r\n-- Docs: https://docs.pytest.org/en/stable/how-to/capture-warnings.html\r\n"]
