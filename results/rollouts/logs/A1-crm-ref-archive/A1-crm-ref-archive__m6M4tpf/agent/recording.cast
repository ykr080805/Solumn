[74.14221, "i", "cat > casebundle/exporter.py <<'PY'\n\"\"\"Customer-facing exports.\n\nAn export is the subset of a case's logs that we are willing to hand back to\nthe account, named by the CRM reference so that support can attach it to the\nticket without renaming anything.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport fnmatch\nimport tarfile\nfrom pathlib import Path\n\nfrom .paths import OUT_DIR, log_dir\nfrom .store import get_case\n\n\ndef _expand_brace_group(pattern: str) -> list[str]:\n    \"\"\"Expand the single CRM-supported brace group in ``pattern``.\n\n    The CRM may send globs such as ``{app,pump}.log``. Python's filename\n    matching helpers do not treat braces specially, so expand one group into\n    ordinary glob patterns. Patterns without a group are returned unchanged.\n    \"\"\"\n    start = pattern.find(\"{\")\n    if start == -1:\n        return [pattern]\n\n    end = pattern.find(\"}\", start + 1)\n    if end == -1:\n        return [pattern]\n\n    prefix = pattern[:start]\n    suffix = pattern[end + 1 :]\n    return [f\"{prefix}{option}{su"]
[74.142582, "o", "cat > casebundle/exporter.py <<'PY'\r\n\u001b[?2004l\r"]
[74.142672, "i", "ffix}\" for option in pattern[start + 1 : end].split(\",\")]\n\n\ndef _included_files(src: Path, include_glob: str) -> list[Path]:\n    \"\"\"Return top-level regular files in ``src`` matching ``include_glob``.\"\"\"\n    patterns = _expand_brace_group(include_glob)\n    matches = [\n        path\n        for path in src.iterdir()\n        if path.is_file()\n        and not path.is_symlink()\n        and any(fnmatch.fnmatchcase(path.name, pattern) for pattern in patterns)\n    ]\n    return sorted(matches, key=lambda path: path.name)\n\n\ndef export_case_archive(case_id: int) -> str:\n    \"\"\"Build the customer-facing export for ``case_id``.\"\"\"\n    case = get_case(case_id)\n    src = log_dir(case.internal_id)\n    if not src.is_dir():\n        raise FileNotFoundError(f\"no log directory for case {case_id}\")\n\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\n\n    with tarfile.open(out, \"w:gz\") as tf:\n        for path in _included_files(src, case.include_glob):\n            tf.add(path, arcname=path.name,"]
