[74.144199, "o", "\u001b[?2004h> "]
[74.144267, "o", "    \"\"\"Return top-level regular files in ``src`` matching ``include_glob``.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.144345, "o", "    patterns = _expand_brace_group(include_glob)\r\n\u001b[?2004l\r\u001b[?2004h>     matches = [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.144426, "o", "        path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.144493, "o", "        for path in src.iterdir()\r\n\u001b[?2004l\r\u001b[?2004h>         if path.is_file()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.14456, "o", "        and not path.is_symlink()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.144626, "o", "        and any(fnmatch.fnmatchcase(path.name, pattern) for pattern in patterns)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.144683, "o", "    ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.144794, "o", "    return sorted(matches, key=lambda path: path.name)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def export_case_archive(case_id: int) -> str:\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.144845, "o", "> "]
[74.144872, "o", "    \"\"\"Build the customer-facing export for ``case_id``.\"\"\"\r\n"]
[74.144912, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[74.145002, "o", "    case = get_case(case_id)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.145057, "o", "    src = log_dir(case.internal_id)\r\n\u001b[?2004l\r\u001b[?2004h>     if not src.is_dir():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.145121, "o", "        raise FileNotFoundError(f\"no log directory for case {case_id}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.145157, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.145211, "o", "    OUT_DIR.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.145255, "o", "> "]
[74.145313, "o", "    out = OUT_DIR / f\"{case.ref}.tar.gz\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.14537, "o", "    with tarfile.open(out, \"w:gz\") as tf:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.145451, "o", "        for path in _included_files(src, case.include_glob):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.145498, "o", "            tf.add(path, arcname=path.name, recursive=False)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     return str(out)\r\n\u001b[?2004l\r"]
[74.145547, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[74.147072, "o", "\u001b[?2004hroot@bf4e11bf1f76:/app# "]
[74.147188, "o", "python -m casebundle export 1 && tar tzf /app/out/CRM-2026-0118.tar.gz\r\n\u001b[?2004l\r"]
[74.337807, "o", "/app/out/CRM-2026-0118.tar.gz\r\n"]
[74.348772, "o", "app.log\r\napp.log.1\r\napp.log.2.gz\r\n"]
[74.348953, "o", "\u001b[?2004hroot@bf4e11bf1f76:/app# "]
[74.349042, "o", "python -m casebundle export 4 && tar tzf /app/out/CRM-2026-0131.tar.gz\r\n\u001b[?2004l\r"]
[74.502896, "o", "/app/out/CRM-2026-0131.tar.gz\r\n"]
[74.509633, "o", "collector-01.log\r\ncollector-02.log\r\n"]
[74.50986, "o", "\u001b[?2004hroot@bf4e11bf1f76:/app# python -m casebundle export 5 && tar tzf /app/out/CRM-2026-0140.tar.gz\r\n\u001b[?2004l\r"]
