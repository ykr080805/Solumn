[29.242182, "i", "cat > casebundle/exporter.py <<'PY'\n\"\"\"Customer-facing exports.\n\nAn export is the subset of a case's logs that we are willing to hand back to\nthe account, named by the CRM reference so that support can attach it to the\nticket without renaming anything.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport fnmatch\nimport tarfile\nfrom pathlib import Path\n\nfrom .paths import OUT_DIR, log_dir\nfrom .store import get_case\n\n\ndef _expand_brace_group(pattern: str) -> list[str]:\n    \"\"\"Expand the single CRM-supported brace group in ``pattern``.\n\n    The CRM may send a glob such as ``{app,pump}.log``. Python's fnmatch does\n    not implement shell brace expansion, so expand that one group before doing\n    ordinary wildcard matching.\n    \"\"\"\n    start = pattern.find(\"{\")\n    if start == -1:\n        return [pattern]\n\n    end = pattern.find(\"}\", start + 1)\n    if end == -1:\n        return [pattern]\n\n    prefix = pattern[:start]\n    suffix = pattern[end + 1 :]\n    return [f\"{prefix}{part}{suffix}\" for part in pattern[start + 1 : e"]
[29.242244, "i", "nd].split(\",\")]\n\n\ndef _included_files(src: Path, include_glob: str) -> list[Path]:\n    patterns = _expand_brace_group(include_glob)\n    return [\n        child\n        for child in sorted(src.iterdir(), key=lambda p: p.name)\n        if child.is_file()\n        and any(fnmatch.fnmatchcase(child.name, pattern) for pattern in patterns)\n    ]\n\n\ndef export_case_archive(case_id: int) -> str:\n    \"\"\"Build the customer-facing export for ``case_id``.\"\"\"\n    case = get_case(case_id)\n    src = log_dir(case.internal_id)\n    if not src.is_dir():\n        raise FileNotFoundError(f\"no log directory for case {case_id}\")\n\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\n\n    with tarfile.open(out, \"w:gz\") as archive:\n        for path in _included_files(src, case.include_glob):\n            archive.add(path, arcname=path.name)\n\n    return str(out)\nPY\n"]
[29.242431, "o", "cat > casebundle/exporter.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.242455, "o", "\"\"\"Customer-facing exports.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.242539, "o", "\u001b[?2004h> "]
[29.242599, "o", "An export is the subset of a case's logs that we are willing to hand back to\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.24275, "o", "the account, named by the CRM reference so that support can attach it to the\r\n\u001b[?2004l\r\u001b[?2004h> ticket without renaming anything.\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
