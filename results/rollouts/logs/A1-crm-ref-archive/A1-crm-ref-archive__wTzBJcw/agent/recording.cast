[33.173358, "o", "    raise SystemExit(main())\r\n                     ^^^^^^\r\n  File \"/app/casebundle/cli.py\", line 45, in main\r\n    print(export_case_archive(int(args[0])))\r\n          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/app/casebundle/exporter.py\", line 50, in export_case_archive\r\n    case = get_case(case_id)\r\n           ^^^^^^^^^^^^^^^^^\r\n  File \"/app/casebundle/store.py\", line 45, in get_case\r\n    raise CaseNotFound(f\"no case with id {case_id}\")\r\ncasebundle.store.CaseNotFound: no case with id 999\r\n"]
