[29.243808, "o", "> "]
[29.243895, "o", "    return [f\"{prefix}{part}{suffix}\" for part in pattern[start + 1 : end].split(\",\")]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.24394, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.244029, "o", "def _included_files(src: Path, include_glob: str) -> list[Path]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.244075, "o", "    patterns = _expand_brace_group(include_glob)\r\n\u001b[?2004l\r\u001b[?2004h>     return [\r\n\u001b[?2004l\r"]
[29.244166, "o", "\u001b[?2004h>         child\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.244219, "o", "        for child in sorted(src.iterdir(), key=lambda p: p.name)\r\n\u001b[?2004l\r"]
[29.24424, "o", "\u001b[?2004h> "]
[29.244285, "o", "        if child.is_file()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.244348, "o", "        and any(fnmatch.fnmatchcase(child.name, pattern) for pattern in patterns)\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.244376, "o", ">     ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.244415, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.244496, "o", "\u001b[?2004h> def export_case_archive(case_id: int) -> str:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.244556, "o", "    \"\"\"Build the customer-facing export for ``case_id``.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.244613, "o", "> "]
[29.244696, "o", "    case = get_case(case_id)\r\n\u001b[?2004l\r\u001b[?2004h>     src = log_dir(case.internal_id)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.24477, "o", "    if not src.is_dir():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.244829, "o", "        raise FileNotFoundError(f\"no log directory for case {case_id}\")\r\n"]
[29.244905, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.244952, "o", "    OUT_DIR.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.245006, "o", "    out = OUT_DIR / f\"{case.ref}.tar.gz\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[29.245023, "o", "\u001b[?2004h> "]
[29.24511, "o", "    with tarfile.open(out, \"w:gz\") as archive:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.245171, "o", "        for path in _included_files(src, case.include_glob):\r\n\u001b[?2004l\r\u001b[?2004h"]
[29.245199, "o", "> "]
[29.245272, "o", "            archive.add(path, arcname=path.name)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.245352, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     return str(out)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.245423, "o", "PY\r\n\u001b[?2004l\r"]
[29.24645, "o", "\u001b[?2004hroot@5fba534b1bcc:/app# "]
