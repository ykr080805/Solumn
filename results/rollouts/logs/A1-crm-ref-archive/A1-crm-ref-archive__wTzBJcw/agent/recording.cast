[29.243541, "o", "        return [pattern]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[29.243606, "o", "    end = pattern.find(\"}\", start + 1)\r\n\u001b[?2004l\r\u001b[?2004h>     if end == -1:\r\n\u001b[?2004l\r\u001b[?2004h> "]
