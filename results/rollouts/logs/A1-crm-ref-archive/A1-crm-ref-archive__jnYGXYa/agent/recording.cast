[41.772577, "i", "cat > casebundle/exporter.py <<'PY'\n\"\"\"Customer-facing exports.\n\nAn export is the subset of a case's logs that we are willing to hand back to\nthe account, named by the CRM reference so that support can attach it to the\nticket without renaming anything.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport fnmatch\nimport tarfile\nfrom pathlib import Path\n\nfrom .paths import OUT_DIR, log_dir\nfrom .store import get_case\n\n\ndef _expand_one_brace_group(pattern: str) -> list[str]:\n    \"\"\"Return patterns after expanding one ``{a,b}`` brace group.\n\n    Python's glob/fnmatch helpers do not implement the brace expansion that\n    bash applies for CRM patterns such as ``{app,pump}.log``.  The CRM sends at\n    most one brace group, so keep the expansion deliberately small and leave\n    ordinary wildcard handling to ``fnmatch``.\n    \"\"\"\n    start = pattern.find(\"{\")\n    if start == -1:\n        return [pattern]\n\n    end = pattern.find(\"}\", start + 1)\n    if end == -1:\n        return [pattern]\n\n    prefix = pattern[:start]\n    suffi"]
[41.772619, "i", "x = pattern[end + 1 :]\n    return [f\"{prefix}{choice}{suffix}\" for choice in pattern[start + 1 : end].split(\",\")]\n\n\ndef _matching_files(src: Path, include_glob: str) -> list[Path]:\n    patterns = _expand_one_brace_group(include_glob)\n    return sorted(\n        (\n            entry\n            for entry in src.iterdir()\n            if entry.is_file()\n            and not entry.is_symlink()\n            and any(fnmatch.fnmatchcase(entry.name, pattern) for pattern in patterns)\n        ),\n        key=lambda path: path.name,\n    )\n\n\ndef export_case_archive(case_id: int) -> str:\n    \"\"\"Build the customer-facing export for ``case_id``.\n\n    The archive is named by the CRM reference and contains only top-level files\n    from the case log directory whose names match the case's ``include_glob``.\n    \"\"\"\n    case = get_case(case_id)\n    src = log_dir(case.internal_id)\n    if not src.is_dir():\n        raise FileNotFoundError(f\"no log directory for case {case_id}\")\n\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\n    out = OU"]
[41.772625, "i", "T_DIR / f\"{case.ref}.tar.gz\"\n\n    with tarfile.open(out, \"w:gz\") as archive:\n        for path in _matching_files(src, case.include_glob):\n            archive.add(path, arcname=path.name, recursive=False)\n\n    return str(out)\nPY\n"]
[41.772843, "o", "cat > casebundle/exporter.py <<'PY'\r\n\u001b[?2004l\rx = pattern[end + 1 :]\r\n    return [f\"{prefix}{choice}{suffix}\" for choice in pattern[start + 1 : end].split(\",\")]\r\n\r\n\r\ndef _matching_files(src: Path, include_glob: str) -> list[Path]:\r\n    patterns = _expand_one_brace_group(include_glob)\r\n    return sorted(\r\n        (\r\n            entry\r\n            for entry in src.iterdir()\r\n            if entry.is_file()\r\n            and not entry.is_symlink()\r\n            and any(fnmatch.fnmatchcase(entry.name, pattern) for pattern in patterns)\r\n        ),\r\n        key=lambda path: path.name,\r\n    )\r\n\r\n\r\ndef export_case_archive(case_id: int) -> str:\r\n    \"\"\"Build the customer-facing export for ``case_id``.\r\n\r\n    The archive is named by the CRM reference and contains only top-level files\r\n    from the case log directory whose names match the case's ``include_glob``.\r\n    \"\"\"\r\n    case = get_case(case_id)\r\n    src = log_dir(case.internal_id)\r\n    if not src.is_dir():\r\n        raise FileNotFoundError(f\"no log directory for case"]
[41.772866, "o", " {case_id}\")\r\n\r\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\r\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\r\n\r\n    with tarfile.open(out, \"w:gz\") as archive:\r\n        for path in _matching_files(src, case.include_glob):\r\n            archive.add(path, arcname=path.name, recursive=False)\r\n\r\n    return str(out)\r\nPY\r\n"]
