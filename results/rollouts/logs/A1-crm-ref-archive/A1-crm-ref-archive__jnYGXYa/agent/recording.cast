[67.925595, "o", "\u001b[1mdiff --git a/casebundle/exporter.py b/casebundle/exporter.py\u001b[m\r\n\u001b[1mindex eca00ef..fb7e599 100755\u001b[m\r\n\u001b[1m--- a/casebundle/exporter.py\u001b[m\r\n\u001b[1m+++ b/casebundle/exporter.py\u001b[m\r\n"]
[67.925643, "o", "\u001b[36m@@ -7,10 +7,65 @@\u001b[m \u001b[mticket without renaming anything.\u001b[m\r\n \u001b[m\r\n from __future__ import annotations\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport fnmatch\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport tarfile\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom pathlib import Path\u001b[m\r\n\u001b[32m+\u001b[m\r\n"]
[67.925755, "o", "\u001b[32m+\u001b[m\u001b[32mfrom .paths import OUT_DIR, log_dir\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom .store import get_case\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef _expand_one_brace_group(pattern: str) -> list[str]:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    \"\"\"Return patterns after expanding one ``{a,b}`` brace group.\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    Python's glob/fnmatch helpers do not implement the brace expansion that\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    bash applies for CRM patterns such as ``{app,pump}.log``.  The CRM sends at\u001b[m\r\n"]
[67.925806, "o", "\u001b[32m+\u001b[m\u001b[32m    most one brace group, so keep the expansion deliberately small and leave\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    ordinary wildcard handling to ``fnmatch``.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    \"\"\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    start = pattern.find(\"{\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if start == -1:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        return [pattern]\u001b[m\r\n\u001b[32m+\u001b[m\r\n"]
[67.925884, "o", "\u001b[32m+\u001b[m\u001b[32m    end = pattern.find(\"}\", start + 1)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if end == -1:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        return [pattern]\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    prefix = pattern[:start]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    suffix = pattern[end + 1 :]\u001b[m\r\n"]
[67.925959, "o", "\u001b[32m+\u001b[m\u001b[32m    return [f\"{prefix}{choice}{suffix}\" for choice in pattern[start + 1 : end].split(\",\")]\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef _matching_files(src: Path, include_glob: str) -> list[Path]:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    patterns = _expand_one_brace_group(include_glob)\u001b[m\r\n\u001b[7m--More--\u001b[27m"]
[92.027011, "i", "q"]
[92.027381, "o", "\r\u001b[K"]
[92.028244, "o", "\u001b[?2004hroot@7f5d74dff2af:/app# "]
