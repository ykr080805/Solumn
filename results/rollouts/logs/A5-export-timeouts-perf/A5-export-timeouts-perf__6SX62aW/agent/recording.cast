[80.435871, "i", "cat > tests/test_exporter.py <<'PY'\n\"\"\"Coverage for customer-facing exports.\"\"\"\n\nimport subprocess\nimport tarfile\nfrom pathlib import Path\n\nimport pytest\n\nfrom casebundle.exporter import export_case_archive\nfrom casebundle.store import CaseNotFound\n\n\ndef _members(path: str) -> set[str]:\n    with tarfile.open(path) as tf:\n        return {m.name for m in tf.getmembers() if m.isfile()}\n\n\ndef test_export_is_named_by_crm_reference():\n    out = export_case_archive(1)\n    assert out == \"/app/out/CRM-2026-0118.tar.gz\"\n    assert Path(out).is_file()\n\n\ndef test_export_uses_include_glob():\n    out = export_case_archive(1)\n    assert _members(out) == {\"app.log\", \"app.log.1\", \"app.log.2.gz\"}\n\n\ndef test_export_wildcard_stays_top_level_and_skips_scratch_files():\n    out = export_case_archive(2)\n    assert _members(out) == {\"app.log\", \"pump.log\"}\n\n\ndef test_export_supports_one_brace_group():\n    out = export_case_archive(5)\n    assert _members(out) == {\"app.log\", \"pump.log\"}\n\n\ndef test_export_unknown_case_is_rejected():\n    "]
[80.436028, "i", "with pytest.raises(CaseNotFound):\n        export_case_archive(9999)\n\n\ndef test_cli_export_prints_the_path():\n    proc = subprocess.run(\n        [\"python\", \"-m\", \"casebundle\", \"export\", \"5\"],\n        capture_output=True,\n        text=True,\n        cwd=\"/app\",\n    )\n    assert proc.returncode == 0, proc.stderr\n    assert proc.stdout.strip() == \"/app/out/CRM-2026-0140.tar.gz\"\nPY\n"]
[80.436132, "o", "cat > tests/test_exporter.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
