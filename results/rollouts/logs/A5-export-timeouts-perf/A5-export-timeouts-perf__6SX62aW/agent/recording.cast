[80.267762, "o", "    that wildcard and brace handling stays on the fast archive path rather than\r\n\u001b[?2004l\r\u001b[?2004h>     walking large customer directories in Python.  Only top-level regular files\r\n\u001b[?2004l\r\u001b[?2004h>     are passed to tar, and tar receives them via stdin to avoid argv-size limits\r\n\u001b[?2004l\r\u001b[?2004h>     on cases with many rotated logs.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     case = get_case(case_id)\r\n\u001b[?2004l\r\u001b[?2004h>     src = log_dir(case.internal_id)\r\n\u001b[?2004l\r\u001b[?2004h>     if not src.is_dir():\r\n\u001b[?2004l\r\u001b[?2004h>         raise FileNotFoundError(f\"no log directory for case {case_id}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[80.267788, "o", "> "]
[80.267841, "o", "    OUT_DIR.mkdir(parents=True, exist_ok=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.267924, "o", "    out = OUT_DIR / f\"{case.ref}.tar.gz\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
