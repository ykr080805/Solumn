[93.918309, "o", "Traceback (most recent call last):\r\n  File \"<frozen runpy>\", line 198, in _run_module_as_main\r\n  File \"<frozen runpy>\", line 88, in _run_code\r\n  File \"/app/casebundle/__main__.py\", line 3, in <module>\r\n    raise SystemExit(main())\r\n                     ^^^^^^\r\n  File \"/app/casebundle/cli.py\", line 45, in main\r\n    print(export_case_archive(int(args[0])))\r\n          ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^\r\n  File \"/app/casebundle/exporter.py\", line 26, in export_case_archive\r\n    case = get_case(case_id)\r\n           ^^^^^^^^^^^^^^^^^\r\n  File \"/app/casebundle/store.py\", line 45, in get_case\r\n    raise CaseNotFound(f\"no case with id {case_id}\")\r\ncasebundle.store.CaseNotFound: no case with id 9999\r\n"]
