[94.255675, "o", "\u001b[1mdiff --git a/casebundle/exporter.py b/casebundle/exporter.py\u001b[m\r\n\u001b[1mindex eca00ef..5aa473a 100755\u001b[m\r\n"]
[94.25579, "o", "\u001b[1m--- a/casebundle/exporter.py\u001b[m\r\n\u001b[1m+++ b/casebundle/exporter.py\u001b[m\r\n\u001b[36m@@ -7,10 +7,43 @@\u001b[m \u001b[mticket without renaming anything.\u001b[m\r\n \u001b[m\r\n from __future__ import annotations\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom shlex import quote\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom .paths import OUT_DIR, log_dir\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom .shellutil import run_shell\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom .store import get_case\u001b[m\r\n\u001b[32m+\u001b[m\r\n \u001b[m\r\n"]
[94.255893, "o", " def export_case_archive(case_id: int) -> str:\u001b[m\r\n     \"\"\"Build the customer-facing export for ``case_id``.\u001b[m\r\n \u001b[m\r\n\u001b[31m-    Not implemented yet -- see the ticket.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    The CRM-provided include glob is expanded by Bash in the log directory so\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    that wildcard and brace handling stays on the fast archive path rather than\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    walking large customer directories in Python.  Only top-level regular files\u001b[m\r\n"]
[94.255947, "o", "\u001b[32m+\u001b[m\u001b[32m    are passed to tar, and tar receives them via stdin to avoid argv-size limits\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    on cases with many rotated logs.\u001b[m\r\n     \"\"\"\u001b[m\r\n\u001b[31m-    raise NotImplementedError\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    case = get_case(case_id)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    src = log_dir(case.internal_id)\u001b[m\r\n"]
[94.256023, "o", "\u001b[32m+\u001b[m\u001b[32m    if not src.is_dir():\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise FileNotFoundError(f\"no log directory for case {case_id}\")\u001b[m\r\n\u001b[32m+\u001b[m\r\n"]
[94.256083, "o", "\u001b[32m+\u001b[m\u001b[32m    OUT_DIR.mkdir(parents=True, exist_ok=True)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    out = OUT_DIR / f\"{case.ref}.tar.gz\"\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    command = f\"\"\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mshopt -s nullglob\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfiles=()\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfor f in {case.include_glob}; do\u001b[m\r\n"]
[94.256148, "o", "\u001b[32m+\u001b[m\u001b[32m    if [[ \"$f\" != */* && -f \"$f\" ]]; then\u001b[m\r\n\u001b[7m--More--\u001b[27m"]
