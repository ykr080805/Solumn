[12.205958, "o", "\u001b[?2004hroot@60c35eb89da5:/app# "]
[45.433331, "i", "cat > casebundle/exporter.py <<'PY'\n\"\"\"Customer-facing exports.\n\nAn export is the subset of a case's logs that we are willing to hand back to\nthe account, named by the CRM reference so that support can attach it to the\nticket without renaming anything.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport shlex\n\nfrom .paths import OUT_DIR, log_dir\nfrom .shellutil import run_shell\nfrom .store import get_case\n\n\ndef _expand_one_brace_group(pattern: str) -> list[str]:\n    \"\"\"Expand the single CRM-supported brace group in ``pattern``.\n\n    The CRM sends shell-style globs, with at most one simple brace group such\n    as ``{app,pump}.log``. ``find -name`` does not understand brace groups, so\n    expand that small piece here while leaving ordinary glob wildcards for\n    ``find`` to evaluate against the directory entries.\n    \"\"\"\n    start = pattern.find(\"{\")\n    if start == -1:\n        return [pattern]\n\n    end = pattern.find(\"}\", start + 1)\n    if end == -1:\n        return [pattern]\n\n    prefix = pattern[:start]\n    suffi"]
[45.433625, "i", "x = pattern[end + 1 :]\n    return [f\"{prefix}{part}{suffix}\" for part in pattern[start + 1 : end].split(\",\")]\n\n\ndef _find_name_expression(patterns: list[str]) -> str:\n    \"\"\"Return a shell-safe find expression matching any of ``patterns``.\"\"\"\n    tests = []\n    for pattern in patterns:\n        if tests:\n            tests.append(\"-o\")\n        tests.extend([\"-name\", shlex.quote(pattern)])\n    return r\"\\( \" + \" \".join(tests) + r\" \\)\"\n\n\ndef export_case_archive(case_id: int) -> str:\n    \"\"\"Build the customer-facing export for ``case_id``.\n\n    The archive is named by CRM reference and contains only top-level regular\n    files whose names match the case's include glob. Member names are just the\n    file names, with no leading directory component.\n    \"\"\"\n    case = get_case(case_id)\n    src = log_dir(case.internal_id)\n    if not src.is_dir():\n        raise FileNotFoundError(f\"no log directory for case {case_id}\")\n\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\n\n    patterns "]
[45.433805, "o", "cat > casebundle/exporter.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"Customer-facing exports.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[45.433916, "i", "= _expand_one_brace_group(case.include_glob)\n    name_expr = _find_name_expression(patterns)\n\n    command = (\n        \"set -o pipefail; \"\n        f\"find . -maxdepth 1 -type f {name_expr} -printf '%f\\\\0' \"\n        f\"| tar --null -czf {shlex.quote(str(out))} -T -\"\n    )\n    run_shell(command, cwd=str(src))\n    return str(out)\nPY\npython -m py_compile casebundle/exporter.py\n"]
