[11.947638, "o", "\r\n--- cases ---\r\n"]
[12.193778, "o", "Case(id=1, internal_id=4471, ref='CRM-2026-0118', account='Northwind Utilities', include_glob='app.log*', retention_days=90)\r\nCase(id=2, internal_id=4472, ref='CRM-2026-0119', account='Harrow Water', include_glob='*.log', retention_days=30)\r\nCase(id=3, internal_id=4473, ref='CRM-2026-0125', account='Baltic Grid', include_glob='app.log*', retention_days=365)\r\nCase(id=4, internal_id=4480, ref='CRM-2026-0131', account='Northwind Utilities', include_glob='collector-*.log', retention_days=90)\r\nCase(id=5, internal_id=4490, ref='CRM-2026-0140', account='Harrow Water', include_glob='{app,pump}.log', retention_days=30)\r\n"]
