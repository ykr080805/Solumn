[107.044259, "i", "cat > casebundle/exporter.py <<'PY'\n\"\"\"Customer-facing exports.\n\nAn export is the subset of a case's logs that we are willing to hand back to\nthe account, named by the CRM reference so that support can attach it to the\nticket without renaming anything.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport shlex\n\nfrom .paths import OUT_DIR, log_dir\nfrom .shellutil import run_shell\nfrom .store import get_case\n\n\ndef _expand_one_brace_group(pattern: str) -> list[str]:\n    \"\"\"Expand the single brace group supported by ``cases.include_glob``.\n\n    ``find -name`` understands normal shell wildcards (``*``, ``?`` and\n    character classes), but not brace alternation. The CRM only sends at most\n    one brace group, so expand that small alternation here and leave the real\n    filesystem matching to ``find``.\n    \"\"\"\n    start = pattern.find(\"{\")\n    if start == -1:\n        return [pattern]\n\n    end = pattern.find(\"}\", start + 1)\n    if end == -1:\n        return [pattern]\n\n    prefix = pattern[:start]\n    suffix = pattern[end "]
[107.044321, "i", "+ 1 :]\n    return [f\"{prefix}{part}{suffix}\" for part in pattern[start + 1 : end].split(\",\")]\n\n\ndef _find_name_expression(patterns: list[str]) -> str:\n    \"\"\"Build a shell-quoted ``find`` expression for basename patterns.\"\"\"\n    tests = [f\"-name {shlex.quote(pattern)}\" for pattern in patterns]\n    if len(tests) == 1:\n        return tests[0]\n    return r\"\\( \" + \" -o \".join(tests) + r\" \\)\"\n\n\ndef export_case_archive(case_id: int) -> str:\n    \"\"\"Build the customer-facing export for ``case_id``.\n\n    The archive contains only top-level regular files whose names match the\n    case's ``include_glob``. Members are stored under their own filenames, with\n    no leading directory component.\n    \"\"\"\n    case = get_case(case_id)\n    src = log_dir(case.internal_id)\n    if not src.is_dir():\n        raise FileNotFoundError(f\"no log directory for case {case_id}\")\n\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\n\n    patterns = _expand_one_brace_group(case.include_glob)\n    name_expr = _"]
[107.044394, "i", "find_name_expression(patterns)\n\n    command = (\n        \"set -o pipefail; \"\n        f\"find . -maxdepth 1 -type f {name_expr} -printf '%P\\\\0' \"\n        f\"| tar --null -czf {shlex.quote(str(out))} -T -\"\n    )\n    run_shell(command, cwd=str(src))\n    return str(out)\nPY\npython -m casebundle export 1\npython -m casebundle export 2\npython -m casebundle export 5\nfor f in /app/out/CRM-2026-0118.tar.gz /app/out/CRM-2026-0119.tar.gz /app/out/CRM-2026-0140.tar.gz; do echo \"== $f\"; tar tzf \"$f\" | sort; done\n"]
