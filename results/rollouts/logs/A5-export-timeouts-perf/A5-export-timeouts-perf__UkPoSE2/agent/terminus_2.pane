def export_case_archive(case_id: int) -> str:$
    """Build the customer-facing export for ``case_id`` and return it\
s path."""$
    case = get_case(case_id)$
    src = log_dir(case.internal_id)$
    if not src.is_dir():$
        raise FileNotFoundError(f"no log directory for case {case_id}\
")$
$
    OUT_DIR.mkdir(parents=True, exist_ok=True)$
    out = OUT_DIR / f"{case.ref}.tar.gz"$
$
    patterns = _expand_one_brace_group(case.include_glob)$
    name_expr = _find_name_expression(patterns)$
$
    # Keep the bulk run cheap: let find scan only the top level of th\
e one log$
    # directory, and stream the selected names straight to tar as a N\
UL-delimited$
    # file list. This avoids recursive Python walks and avoids buildi\
ng a huge$
    # argv for cases with many rotated files.$
    command = ($
        "set -o pipefail; "$
        f"cd {shlex.quote(str(src))} && "$
