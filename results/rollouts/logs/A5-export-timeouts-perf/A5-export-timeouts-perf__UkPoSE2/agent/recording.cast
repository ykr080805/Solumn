[38.477572, "o", "1:# casebundle runbook\r\r\n2-\r\r\n3:On-call notes for the support log bundler. Keep this in sync with the code.\r\r\n4-\r\r\n5:## Why the archive steps use wildcards\r\r\n"]
[38.477832, "o", "6-\r\r\n7-The log directories hold rotated files (`app.log`, `app.log.1`, `app.log.2.gz`)\r\r\n8-alongside scratch files the collector leaves behind. Archive steps select what\r\r\n9:they want with a wildcard rather than enumerating the directory, so that a new\r\r\n10-rotation suffix does not need a code change.\r\r\n11-\r\r\n12-Some accounts have more than one collector writing into the same directory, and\r\r\n--\r\n17-\r\r\n18-## Retention\r\r\n19-\r\r\n20:`cases.retention_days` is advisory. The cleanup job reads it; the bundler and\r\r\n21-the exporter do not.\r\r\n22-\r\r\n23-## Where the case index comes from\r\r\n24-\r\r\n25-`cases` is written by the CRM sync job every fifteen minutes. Support agents\r\r\n26:edit case fields in the CRM, so `ref`, `account` and `include_glob` are\r\r\n27-whatever the CRM last handed us. Nothing in this repo writes to that table.\r\r\n"]
[38.478025, "o", "\u001b[?2004hroot@497a069b69a9:/app# "]
[38.736589, "i", "tmp=$(mktemp -d); mkdir -p \"$tmp/src\"; touch \"$tmp/src/app.log\" \"$tmp/src/app.log.1\" \"$tmp/src/pump.log\"; tar czf \"$tmp/q.tar.gz\" -C \"$tmp/src\" --wildcards 'app.log*' 2>\"$tmp/err\"; rc=$?; echo rc=$rc; cat \"$tmp/err\"; tar tzf \"$tmp/q.tar.gz\" 2>/dev/null || true; rm -rf \"$tmp\"\n"]
[38.737079, "o", "tmp=$(mktemp -d); mkdir -p \"$tmp/src\"; touch \"$tmp/src/app.log\" \"$tmp/src/app.log.1\" \"$tmp/src/pump.log\"; tar czf \"$tmp/q.tar.gz\" -C \"$tmp/src\" --wildcards 'app.log*' 2>\"$tmp/err\"; rc=$?; echo rc=$rc; cat \"$tmp/err\"; tar tzf \"$tmp/q.tar.gz\" 2>/dev/null || true; rm -rf \"$tmp\"\r\n\u001b[?2004l\r"]
[38.747768, "o", "rc=2\r\n"]
[38.748749, "o", "tar: app.log*: Cannot stat: No such file or directory\r\ntar: Exiting with failure status due to previous errors\r\n"]
[38.753214, "o", "\u001b[?2004hroot@497a069b69a9:/app# "]
[78.665575, "i", "cat > casebundle/exporter.py <<'PY'\n\"\"\"Customer-facing exports.\n\nAn export is the subset of a case's logs that we are willing to hand back to\nthe account, named by the CRM reference so that support can attach it to the\nticket without renaming anything.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport shlex\n\nfrom .paths import OUT_DIR, log_dir\nfrom .shellutil import run_shell\nfrom .store import get_case\n\n\ndef _expand_one_brace_group(pattern: str) -> list[str]:\n    \"\"\"Expand the single CRM brace group supported by ``include_glob``.\n\n    Bash-style ``{app,pump}.log`` should match exactly ``app.log`` and\n    ``pump.log``. If there is no complete comma-separated brace group, leave\n    the pattern alone so ordinary glob metacharacters keep their usual meaning.\n    \"\"\"\n    start = pattern.find(\"{\")\n    if start == -1:\n        return [pattern]\n\n    end = pattern.find(\"}\", start + 1)\n    if end == -1:\n        return [pattern]\n\n    body = pattern[start + 1 : end]\n    if \",\" not in body:\n        return [pattern]\n\n    pre"]
[78.665652, "i", "fix = pattern[:start]\n    suffix = pattern[end + 1 :]\n    return [f\"{prefix}{part}{suffix}\" for part in body.split(\",\")]\n\n\ndef _find_name_expression(patterns: list[str]) -> str:\n    \"\"\"Return a safely quoted ``find`` name expression for shell execution.\"\"\"\n    return \" -o \".join(f\"-name {shlex.quote(pattern)}\" for pattern in patterns)\n\n\ndef export_case_archive(case_id: int) -> str:\n    \"\"\"Build the customer-facing export for ``case_id`` and return its path.\"\"\"\n    case = get_case(case_id)\n    src = log_dir(case.internal_id)\n    if not src.is_dir():\n        raise FileNotFoundError(f\"no log directory for case {case_id}\")\n\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\n\n    patterns = _expand_one_brace_group(case.include_glob)\n    name_expr = _find_name_expression(patterns)\n\n    # Keep the bulk run cheap: let find scan only the top level of the one log\n    # directory, and stream the selected names straight to tar as a NUL-delimited\n    # file list. This avoids recursive "]
[78.665834, "i", "Python walks and avoids building a huge\n    # argv for cases with many rotated files.\n    command = (\n        \"set -o pipefail; \"\n        f\"cd {shlex.quote(str(src))} && \"\n        f\"find . -maxdepth 1 -type f \\\\( {name_expr} \\\\) -printf '%P\\\\0' | \"\n        f\"tar --null --verbatim-files-from -czf {shlex.quote(str(out))} -C . -T -\"\n    )\n    run_shell(command)\n    return str(out)\nPY\npython -m casebundle export 1\n"]
