[98.293936, "o", "$\r\ndef export_case_archive(case_id: int) -> str:$\r\n    \"\"\"Build the customer-facing export for ``case_id`` and return it\\\r\ns path.\"\"\"$\r\n    case = get_case(case_id)$\r\n    src = log_dir(case.internal_id)$\r\n    if not src.is_dir():$\r\n        raise FileNotFoundError(f\"no log directory for case {case_id}\\\r\n\")$\r\n$\r\n    OUT_DIR.mkdir(parents=True, exist_ok=True)$\r\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"$\r\n$\r\n    patterns = _expand_one_brace_group(case.include_glob)$\r\n    name_expr = _find_name_expression(patterns)$\r\n$\r\n    # Keep the bulk run cheap: let find scan only the top level of th\\\r\ne one log$\r\n"]
[98.294225, "o", "    # directory, and stream the selected names straight to tar as a N\\\r\nUL-delimited$\r\n    # file list. This avoids recursive Python walks and avoids buildi\\\r\nng a huge$\r\n    # argv for cases with many rotated files.$\r\n    command = ($\r\n        \"set -o pipefail; \"$\r\n        f\"cd {shlex.quote(str(src))} && \"$\r\n        f\"find . -maxdepth 1 -type f \\\\\\\\( {name_expr} \\\\\\\\) -printf \\\r\n'%P\\\\\\\\0' | \"$\r\n        f\"tar --null --verbatim-files-from -czf {shlex.quote(str(out)\\\r\n)} -C . -T -\"$\r\n    )$\r\n    run_shell(command)$\r\n    return str(out)$\r\n"]
