[128.564739, "o", "\u001b[31m-    Not implemented yet -- see the ticket.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    The archive is named by the CRM reference and contains only top-level files\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    in the case log directory whose names match the case's include glob.\u001b[m\r\n     \"\"\"\u001b[m\r\n\u001b[31m-    raise NotImplementedError\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    case = get_case(case_id)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    src = log_dir(case.internal_id)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if not src.is_dir():\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise FileNotFoundError(f\"no log directory for case {case_id}\")\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    OUT_DIR.mkdir(parents=True, exist_ok=True)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    out = OUT_DIR / f\"{case.ref}.tar.gz\"\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    patterns = _expand_one_brace_group(case.include_glob)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    pattern_words = \" \".join(shlex.quote(pattern) for pattern in patterns)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    out_word = shlex.quote(str(out))\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    # Use bash globbing in the log directory rather than building a file vector\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  "]
[128.564801, "o", "  # by walking the directory in Python.  The unquoted $pat is intentional: it\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    # applies ordinary shell wildcards to each trusted pattern value.  Brace\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    # groups have already been expanded above, because brace expansion does not\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    # happen after parameter expansion in bash.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    command = f\"\"\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mshopt -s nullglob\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mpatterns=({pattern_words})\u001b[m\r\n"]
[128.564856, "o", "\u001b[32m+\u001b[m\u001b[32mfiles=()\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdeclare -A seen=()\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mIFS=\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfor pat in \"${{patterns[@]}}\"; do\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for f in $pat; do\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        if [[ -f \"$f\" && -z \"${{seen[$f]+x}}\" ]]; then\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            files+=(\"$f\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            seen[$f]=1\u001b[m\r\n"]
[128.564933, "o", "\u001b[32m+\u001b[m\u001b[32m        fi\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    done\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdone\u001b[m\r\n"]
[128.565008, "o", "\u001b[32m+\u001b[m\u001b[32mif (( ${{#files[@]}} == 0 )); then\u001b[m\r\n\u001b[7m--More--\u001b[27m\r\u001b[KMost commands optionally preceded by integer argument k.  Defaults in brackets.\r\nStar (*) indicates argument becomes new default.\r\n-------------------------------------------------------------------------------\r\n<space>                 Display next k lines of text [current screen size]\r\nz                       Display next k lines of text [current screen size]*\r\n<return>                Display next k lines of text [1]*\r\nd or ctrl-D             Scroll k lines [current scroll size, initially 11]*\r\nq or Q or <interrupt>   Exit from more\r\ns                       Skip forward k lines of text [1]\r\nf                       Skip forward k screenfuls of text [1]\r\nb or ctrl-B             Skip backwards k screenfuls of text [1]\r\n'                       Go to place where previous search started\r\n=                       Display current line number\r\n/<regular expression>   Search for kth occurrence of regular expression [1]\r\nn                       Se"]
[128.565079, "o", "arch for kth occurrence of last r.e [1]\r\n!<cmd> or :!<cmd>       Execute <cmd> in a subshell\r\nv                       Start up '/usr/bin/vi' at current line\r\nctrl-L                  Redraw screen\r\n:n                      Go to kth next file [1]\r\n:p                      Go to kth previous file [1]\r\n:f                      Display current file name and line number\r\n.                       Repeat previous command\r\n-------------------------------------------------------------------------------\r\n\u001b[7m--More--\u001b[27m\r\u001b[32m+\u001b[m\u001b[32m    tar czf {out_word} --files-from /dev/null\u001b[m\r\n\u001b[7m--More--\u001b[27m"]
