[251.840273, "o", " casebundle/exporter.py | 71 \u001b[32m+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++\u001b[m\u001b[31m--\u001b[m\r\n 1 file changed, 69 insertions(+), 2 deletions(-)\r\n"]
[251.840464, "o", "\u001b[?2004hroot@f80110b6f52e:/app# "]
[251.840553, "o", "GIT_PAGER=cat git diff -- casebundle/exporter.py | sed -n '1,220p'\r\n\u001b[?2004l\r"]
[251.842118, "o", "diff --git a/casebundle/exporter.py b/casebundle/exporter.py\r\nindex eca00ef..eea423c 100755\r\n--- a/casebundle/exporter.py\r\n+++ b/casebundle/exporter.py\r\n@@ -7,10 +7,77 @@ ticket without renaming anything.\r\n \r\n from __future__ import annotations\r\n \r\n+import shlex\r\n+\r\n+from .paths import OUT_DIR, log_dir\r\n+from .shellutil import run_shell\r\n+from .store import get_case\r\n+\r\n+\r\n+def _expand_one_brace_group(pattern: str) -> list[str]:\r\n+    \"\"\"Return the glob patterns represented by one optional brace group.\r\n+\r\n+    The CRM sends simple shell-style include globs.  One brace group is allowed,\r\n+    so ``{app,pump}.log`` means exactly ``app.log`` and ``pump.log``.  Patterns\r\n+    without a comma-bearing brace group are ordinary globs and are returned as-is.\r\n+    \"\"\"\r\n+    start = pattern.find(\"{\")\r\n+    if start == -1:\r\n+        return [pattern]\r\n+\r\n+    end = pattern.find(\"}\", start + 1)\r\n+    if end == -1:\r\n+        return [pattern]\r\n+\r\n+    body = pattern[start + 1 : end]\r\n+    if \",\" not in body:\r\n+        retu"]
[251.842156, "o", "rn [pattern]\r\n+\r\n+    prefix = pattern[:start]\r\n+    suffix = pattern[end + 1 :]\r\n+    return [f\"{prefix}{part}{suffix}\" for part in body.split(\",\")]\r\n+\r\n \r\n def export_case_archive(case_id: int) -> str:\r\n     \"\"\"Build the customer-facing export for ``case_id``.\r\n \r\n-    Not implemented yet -- see the ticket.\r\n+    The archive is named by the CRM reference and contains only top-level files\r\n+    in the case log directory whose names match the case's include glob.\r\n     \"\"\"\r\n-    raise NotImplementedError\r\n+    case = get_case(case_id)\r\n+    src = log_dir(case.internal_id)\r\n+    if not src.is_dir():\r\n+        raise FileNotFoundError(f\"no log directory for case {case_id}\")\r\n+\r\n+    OUT_DIR.mkdir(parents=True, exist_ok=True)\r\n+    out = OUT_DIR / f\"{case.ref}.tar.gz\"\r\n+\r\n+    patterns = _expand_one_brace_group(case.include_glob)\r\n+    pattern_words = \" \".join(shlex.quote(pattern) for pattern in patterns)\r\n+    out_word = shlex.quote(str(out))\r\n+\r\n+    # Use bash globbing in the log directory rather than building"]
[251.842273, "o", " a file vector\r\n+    # by walking the directory in Python.  The unquoted $pat is intentional: it\r\n+    # applies ordinary shell wildcards to each trusted pattern value.  Brace\r\n+    # groups have already been expanded above, because brace expansion does not\r\n+    # happen after parameter expansion in bash.  Matches are streamed to tar so\r\n+    # large rotated-log cases do not have to fit in one tar argv.\r\n+    command = f\"\"\"\r\n+set -o pipefail\r\n+shopt -s nullglob\r\n+patterns=({pattern_words})\r\n+{{\r\n+    declare -A seen=()\r\n+    IFS=\r\n+    for pat in \"${{patterns[@]}}\"; do\r\n+        for f in $pat; do\r\n+            if [[ \"$f\" != */* && -f \"$f\" && -z \"${{seen[$f]+x}}\" ]]; then\r\n+                printf '%s\\0' \"$f\"\r\n+                seen[$f]=1\r\n+            fi\r\n+        done\r\n+    done\r\n+}} | tar czf {out_word} --null --verbatim-files-from --files-from -\r\n+\"\"\"\r\n+    run_shell(command, cwd=str(src))\r\n+    return str(out)\r\n"]
