[21.482653, "o", "d data/logs/4471\r\nd data/logs/4472\r\nd data/logs/4473\r\nd data/logs/4480\r\nd data/logs/4490\r\nf data/logs/4471/app.log\r\nf data/logs/4471/app.log.1\r\nf data/logs/4471/app.log.2.gz\r\nf data/logs/4471/collector-01.log\r\nf data/logs/4471/scratch.tmp\r\nf data/logs/4472/app.log\r\nf data/logs/4472/pump.log\r\nf data/logs/4472/scratch.tmp\r\nf data/logs/4473/app.log\r\nf data/logs/4473/app.log.1\r\nf data/logs/4473/notes.txt\r\nf data/logs/4480/app.log\r\nf data/logs/4480/collector-01.log\r\nf data/logs/4480/collector-02.log\r\nf data/logs/4490/app.log\r\nf data/logs/4490/pump.log\r\n"]
