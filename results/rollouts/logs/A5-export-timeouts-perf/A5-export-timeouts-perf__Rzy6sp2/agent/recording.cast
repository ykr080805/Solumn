[245.37733, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('casebundle/exporter.py')\ns = p.read_text()\nold = '''    # Use bash globbing in the log directory rather than building a file vector\n    # by walking the directory in Python.  The unquoted $pat is intentional: it\n    # applies ordinary shell wildcards to each trusted pattern value.  Brace\n    # groups have already been expanded above, because brace expansion does not\n    # happen after parameter expansion in bash.\n    command = f\"\"\"\nshopt -s nullglob\npatterns=({pattern_words})\nfiles=()\ndeclare -A seen=()\nIFS=\nfor pat in \"${{patterns[@]}}\"; do\n    for f in $pat; do\n        if [[ -f \"$f\" && -z \"${{seen[$f]+x}}\" ]]; then\n            files+=(\"$f\")\n            seen[$f]=1\n        fi\n    done\ndone\nif (( ${{#files[@]}} == 0 )); then\n    tar czf {out_word} --files-from /dev/null\nelse\n    tar czf {out_word} -- \"${{files[@]}}\"\nfi\n\"\"\"\n'''\nnew = '''    # Use bash globbing in the log directory rather than building a file vector\n    # by walking the directory in Python.  The"]
[245.377519, "i", " unquoted $pat is intentional: it\n    # applies ordinary shell wildcards to each trusted pattern value.  Brace\n    # groups have already been expanded above, because brace expansion does not\n    # happen after parameter expansion in bash.  Matches are streamed to tar so\n    # large rotated-log cases do not have to fit in one tar argv.\n    command = f\"\"\"\nset -o pipefail\nshopt -s nullglob\npatterns=({pattern_words})\n{{\n    declare -A seen=()\n    IFS=\n    for pat in \"${{patterns[@]}}\"; do\n        for f in $pat; do\n            if [[ \"$f\" != */* && -f \"$f\" && -z \"${{seen[$f]+x}}\" ]]; then\n                printf '%s\\\\0' \"$f\"\n                seen[$f]=1\n            fi\n        done\n    done\n}} | tar czf {out_word} --null --verbatim-files-from --files-from -\n\"\"\"\n'''\nif old not in s:\n    raise SystemExit('expected block not found')\np.write_text(s.replace(old, new))\nPY\n"]
