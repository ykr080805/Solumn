[128.248003, "o", "sed -n '1,260p' casebundle/exporter.py\r\n\u001b[?2004l\r"]
[128.248872, "o", "\"\"\"Customer-facing exports.\r\n\r\nAn export is the subset of a case's logs that we are willing to hand back to\r\nthe account, named by the CRM reference so that support can attach it to the\r\nticket without renaming anything.\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport shlex\r\n\r\nfrom .paths import OUT_DIR, log_dir\r\nfrom .shellutil import run_shell\r\nfrom .store import get_case\r\n\r\n"]
[128.2489, "o", "\r\ndef _expand_one_brace_group(pattern: str) -> list[str]:\r\n    \"\"\"Return the glob patterns represented by one optional brace group.\r\n\r\n    The CRM sends simple shell-style include globs.  One brace group is allowed,\r\n    so ``{app,pump}.log`` means exactly ``app.log`` and ``pump.log``.  Patterns\r\n    without a comma-bearing brace group are ordinary globs and are returned as-is.\r\n    \"\"\"\r\n    start = pattern.find(\"{\")\r\n    if start == -1:\r\n        return [pattern]\r\n"]
[128.24902, "o", "\r\n    end = pattern.find(\"}\", start + 1)\r\n    if end == -1:\r\n        return [pattern]\r\n\r\n    body = pattern[start + 1 : end]\r\n    if \",\" not in body:\r\n        return [pattern]\r\n\r\n    prefix = pattern[:start]\r\n    suffix = pattern[end + 1 :]\r\n    return [f\"{prefix}{part}{suffix}\" for part in body.split(\",\")]\r\n\r\n\r\ndef export_case_archive(case_id: int) -> str:\r\n    \"\"\"Build the customer-facing export for ``case_id``.\r\n\r\n    The archive is named by the CRM reference and contains only top-level files\r\n    in the case log directory whose names match the case's include glob.\r\n    \"\"\"\r\n    case = get_case(case_id)\r\n    src = log_dir(case.internal_id)\r\n    if not src.is_dir():\r\n        raise FileNotFoundError(f\"no log directory for case {case_id}\")\r\n\r\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\r\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\r\n\r\n    patterns = _expand_one_brace_group(case.include_glob)\r\n    pattern_words = \" \".join(shlex.quote(pattern) for pattern in patterns)\r\n    out_word = shlex.quote(str(out))\r\n\r\n    "]
[128.249158, "o", "# Use bash globbing in the log directory rather than building a file vector\r\n    # by walking the directory in Python.  The unquoted $pat is intentional: it\r\n    # applies ordinary shell wildcards to each trusted pattern value.  Brace\r\n    # groups have already been expanded above, because brace expansion does not\r\n    # happen after parameter expansion in bash.\r\n    command = f\"\"\"\r\nshopt -s nullglob\r\npatterns=({pattern_words})\r\nfiles=()\r\ndeclare -A seen=()\r\nIFS=\r\nfor pat in \"${{patterns[@]}}\"; do\r\n    for f in $pat; do\r\n        if [[ -f \"$f\" && -z \"${{seen[$f]+x}}\" ]]; then\r\n            files+=(\"$f\")\r\n            seen[$f]=1\r\n        fi\r\n    done\r\ndone\r\nif (( ${{#files[@]}} == 0 )); then\r\n    tar czf {out_word} --files-from /dev/null\r\nelse\r\n    tar czf {out_word} -- \"${{files[@]}}\"\r\nfi\r\n\"\"\"\r\n    run_shell(command, cwd=str(src))\r\n    return str(out)\r\n\u001b[?2004h"]
[128.249231, "o", "root@f80110b6f52e:/app# "]
[128.403245, "i", "git diff -- casebundle/exporter.py\n"]
[128.403395, "o", "git diff -- casebundle/exporter.py\r\n\u001b[?2004l\r"]
[128.405214, "o", "\u001b[1mdiff --git a/casebundle/exporter.py b/casebundle/exporter.py\u001b[m\r\n\u001b[1mindex eca00ef..d866381 100755\u001b[m\r\n\u001b[1m--- a/casebundle/exporter.py\u001b[m\r\n\u001b[1m+++ b/casebundle/exporter.py\u001b[m\r\n\u001b[36m@@ -7,10 +7,79 @@\u001b[m \u001b[mticket without renaming anything.\u001b[m\r\n \u001b[m\r\n from __future__ import annotations\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport shlex\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom .paths import OUT_DIR, log_dir\u001b[m\r\n"]
[128.405319, "o", "\u001b[32m+\u001b[m\u001b[32mfrom .shellutil import run_shell\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom .store import get_case\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef _expand_one_brace_group(pattern: str) -> list[str]:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    \"\"\"Return the glob patterns represented by one optional brace group.\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    The CRM sends simple shell-style include globs.  One brace group is allowed,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    so ``{app,pump}.log`` means exactly ``app.log`` and ``pump.log``.  Patterns\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    without a comma-bearing brace group are ordinary globs and are returned as-is.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    \"\"\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    start = pattern.find(\"{\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if start == -1:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        return [pattern]\u001b[m\r\n\u001b[32m+\u001b[m\r\n"]
[128.40543, "o", "\u001b[32m+\u001b[m\u001b[32m    end = pattern.find(\"}\", start + 1)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if end == -1:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        return [pattern]\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    body = pattern[start + 1 : end]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if \",\" not in body:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        return [pattern]\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    prefix = pattern[:start]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    suffix = pattern[end + 1 :]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return [f\"{prefix}{part}{suffix}\" for part in body.split(\",\")]\u001b[m\r\n\u001b[32m+\u001b[m\r\n"]
