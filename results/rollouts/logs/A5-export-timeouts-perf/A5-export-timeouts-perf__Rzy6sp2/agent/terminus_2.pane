+    # large rotated-log cases do not have to fit in one tar argv.
+    command = f"""
+set -o pipefail
+shopt -s nullglob
+patterns=({pattern_words})
+{{
+    declare -A seen=()
+    IFS=
+    for pat in "${{patterns[@]}}"; do
+        for f in $pat; do
+            if [[ "$f" != */* && -f "$f" && -z "${{seen[$f]+x}}" ]]; then
+                printf '%s\0' "$f"
+                seen[$f]=1
+            fi
+        done
+    done
+}} | tar czf {out_word} --null --verbatim-files-from --files-from -
+"""
+    run_shell(command, cwd=str(src))
+    return str(out)
