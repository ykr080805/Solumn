[?2004l"""Customer-facing exports.

An export is the subset of a case's logs that we are willing to hand back to
the account, named by the CRM reference so that support can attach it to the
ticket without renaming anything.
"""

from __future__ import annotations

import shlex

from .paths import OUT_DIR, log_dir
from .shellutil import run_shell
from .store import get_case


def _expand_one_brace_group(pattern: str) -> list[str]:
    """Return the glob patterns represented by one optional brace group.

    The CRM sends simple shell-style include globs.  One brace group is allowed,
    so ``{app,pump}.log`` means exactly ``app.log`` and ``pump.log``.  Patterns
    without a comma-bearing brace group are ordinary globs and are returned as-is.
    """
    start = pattern.find("{")
    if start == -1:
        return [pattern]

    end = pattern.find("}", start + 1)
    if end == -1:
        return [pattern]

    body = pattern[start + 1 : end]
    if "," not in body:
        return [pattern]

    prefix = pattern[:start]
    suffix = pattern[end + 1 :]
    return [f"{prefix}{part}{suffix}" for part in body.split(",")]


def export_case_archive(case_id: int) -> str:
    """Build the customer-facing export for ``case_id``.

    The archive is named by the CRM reference and contains only top-level files
    in the case log directory whose names match the case's include glob.
    """
    case = get_case(case_id)
    src = log_dir(case.internal_id)
    if not src.is_dir():
        raise FileNotFoundError(f"no log directory for case {case_id}")

    OUT_DIR.mkdir(parents=True, exist_ok=True)
    out = OUT_DIR / f"{case.ref}.tar.gz"

    patterns = _expand_one_brace_group(case.include_glob)
    pattern_words = " ".join(shlex.quote(pattern) for pattern in patterns)
    out_word = shlex.quote(str(out))

    # Use bash globbing in the log directory rather than building a file vector
    # by walking the directory in Python.  The unquoted $pat is intentional: it
    # applies ordinary shell wildcards to each trusted pattern value.  Brace
    # groups have already been expanded above, because brace expansion does not
    # happen after parameter expansion in bash.
    command = f"""
shopt -s nullglob
patterns=({pattern_words})
files=()
declare -A seen=()
IFS=
for pat in "${{patterns[@]}}"; do
    for f in $pat; do
        if [[ -f "$f" && -z "${{seen[$f]+x}}" ]]; then
            files+=("$f")
            seen[$f]=1
        fi
    done
done
if (( ${{#files[@]}} == 0 )); then
    tar czf {out_word} --files-from /dev/null
else
    tar czf {out_word} -- "${{files[@]}}"
fi
"""
    run_shell(command, cwd=str(src))
    return str(out)
