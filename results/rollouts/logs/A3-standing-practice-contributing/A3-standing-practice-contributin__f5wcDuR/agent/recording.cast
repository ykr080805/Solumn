[16.474834, "o", "\u001b[?2004hroot@c3eff0b5e085:/app# "]
[51.698017, "i", "cat > casebundle/exporter.py <<'PY'\n\"\"\"Customer-facing exports.\n\nAn export is the subset of a case's logs that we are willing to hand back to\nthe account, named by the CRM reference so that support can attach it to the\nticket without renaming anything.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport shlex\n\nfrom .paths import OUT_DIR, log_dir\nfrom .shellutil import run_shell\nfrom .store import get_case\n\n\ndef _expand_brace_group(pattern: str) -> list[str]:\n    \"\"\"Expand the one brace group supported in CRM include globs.\"\"\"\n    start = pattern.find(\"{\")\n    if start == -1:\n        return [pattern]\n\n    end = pattern.find(\"}\", start + 1)\n    if end == -1:\n        return [pattern]\n\n    prefix = pattern[:start]\n    suffix = pattern[end + 1 :]\n    return [f\"{prefix}{part}{suffix}\" for part in pattern[start + 1 : end].split(\",\")]\n\n\ndef _find_name_predicate(patterns: list[str]) -> str:\n    parts: list[str] = []\n    for pattern in patterns:\n        if parts:\n            parts.append(\"-o\")\n        parts.extend([\"-name\""]
[51.698099, "i", ", shlex.quote(pattern)])\n    return \"\\\\( \" + \" \".join(parts) + \" \\\\)\"\n\n\ndef export_case_archive(case_id: int) -> str:\n    \"\"\"Build the customer-facing export for ``case_id``.\"\"\"\n    case = get_case(case_id)\n    src = log_dir(case.internal_id)\n    if not src.is_dir():\n        raise FileNotFoundError(f\"no log directory for case {case_id}\")\n\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\n\n    patterns = _expand_brace_group(case.include_glob)\n    predicate = _find_name_predicate(patterns)\n    src_arg = shlex.quote(str(src))\n    out_arg = shlex.quote(str(out))\n\n    # The command string is what the rota replays -- see CONTRIBUTING.md.\n    run_shell(\n        f\"find {src_arg} -maxdepth 1 -type f {predicate} -printf '%f\\\\0' \"\n        f\"| sort -z | tar czf {out_arg} -C {src_arg} --null -T -\"\n    )\n    return str(out)\nPY\npython -m pytest tests -q\n"]
