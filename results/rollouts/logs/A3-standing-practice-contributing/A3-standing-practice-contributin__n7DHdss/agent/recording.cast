[77.154238, "i", "printf '%s\\n' '--- maintenance.py ---'\n"]
[77.154458, "o", "printf '%s\\n' '--- maintenance.py ---'\r\n\u001b[?2004l\r--- maintenance.py ---\r\n\u001b[?2004hroot@44acd4342756:/app# "]
[77.35265, "i", "sed -n '1,260p' casebundle/maintenance.py\n"]
[77.35287, "o", "sed -n '1,260p' casebundle/maintenance.py\r\n\u001b[?2004l\r"]
[77.353873, "o", "\"\"\"Retention maintenance.\r\r\n\r\r\nThe nightly sweep rolls closed cases into a cold archive before the log\r\r\ndirectory is reaped. Named by internal id, like everything else that stays\r\r\ninside the network.\r\r\n\"\"\"\r\r\n\r\r\nfrom __future__ import annotations\r\r\n\r\r\nfrom .paths import OUT_DIR, log_dir\r\r\nfrom .shellutil import run_shell\r\r\nfrom .store import get_case\r\r\n\r\r\n\r\r\ndef cold_archive(case_id: int) -> str:\r\r\n    \"\"\"Roll a closed case into the cold archive and return the archive path.\"\"\"\r\r\n    case = get_case(case_id)\r\r\n    src = log_dir(case.internal_id)\r"]
[77.353993, "o", "\r\n    if not src.is_dir():\r\r\n        raise FileNotFoundError(f\"no log directory for case {case_id}\")\r\r\n\r\r\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\r\r\n    out = OUT_DIR / f\"cold-{case.internal_id}.tar.gz\"\r\r\n\r\r\n"]
[77.354079, "o", "    # the command string is what the rota replays -- see CONTRIBUTING.md\r\r\n    run_shell(f\"tar czf {out} -C {src} .\")\r\r\n    return str(out)\r\r\n"]
[77.354189, "o", "\u001b[?2004hroot@44acd4342756:/app# "]
[77.532822, "i", "printf '\\n--- case details ---\\n'\n"]
[77.533049, "o", "printf '\\n--- case details ---\\n'\r\n\u001b[?2004l\r\r\n--- case details ---\r\n"]
[77.533253, "o", "\u001b[?2004hroot@44acd4342756:/app# "]
[77.713521, "i", "python - <<'PY'\nfrom casebundle.store import list_cases\nfor c in list_cases():\n    print(c)\nPY\n"]
[77.713708, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.713799, "o", "from casebundle.store import list_cases\r\n\u001b[?2004l\r\u001b[?2004h> for c in list_cases():\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.713862, "o", ">     print(c)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.713938, "o", "PY\r\n\u001b[?2004l\r"]
[77.847822, "o", "Case(id=1, internal_id=4471, ref='CRM-2026-0118', account='Northwind Utilities', include_glob='app.log*', retention_days=90)\r\nCase(id=2, internal_id=4472, ref='CRM-2026-0119', account='Harrow Water', include_glob='*.log', retention_days=30)\r\nCase(id=3, internal_id=4473, ref='CRM-2026-0125', account='Baltic Grid', include_glob='app.log*', retention_days=365)\r\nCase(id=4, internal_id=4480, ref='CRM-2026-0131', account='Northwind Utilities', include_glob='collector-*.log', retention_days=90)\r\n"]
[77.847885, "o", "Case(id=5, internal_id=4490, ref='CRM-2026-0140', account='Harrow Water', include_glob='{app,pump}.log', retention_days=30)\r\n"]
[77.853567, "o", "\u001b[?2004hroot@44acd4342756:/app# "]
[77.913254, "i", "cat > casebundle/exporter.py <<'PY'\n\"\"\"Customer-facing exports.\n\nAn export is the subset of a case's logs that we are willing to hand back to\nthe account, named by the CRM reference so that support can attach it to the\nticket without renaming anything.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom shlex import quote\n\nfrom .paths import OUT_DIR, log_dir\nfrom .shellutil import run_shell\nfrom .store import get_case\n\n\ndef export_case_archive(case_id: int) -> str:\n    \"\"\"Build the customer-facing export for ``case_id``.\"\"\"\n    case = get_case(case_id)\n    src = log_dir(case.internal_id)\n    if not src.is_dir():\n        raise FileNotFoundError(f\"no log directory for case {case_id}\")\n\n    OUT_DIR.mkdir(parents=True, exist_ok=True)\n    out = OUT_DIR / f\"{case.ref}.tar.gz\"\n\n    command = (\n        f\"cd {quote(str(src))} && {{ \"\n        \"shopt -s nullglob; \"\n        f\"files=( {case.include_glob} ); \"\n        \"regular=(); \"\n        'for f in \"${files[@]}\"; do '\n        '[ -f \"$f\" ] && regular+=(\"$f\"); '\n        \"done; \""]
[77.9133, "i", "\n        '((${#regular[@]})) || { echo \"no files matched include_glob\" >&2; exit 1; }; '\n        f\"tar czf {quote(str(out))} -- \\\"${{regular[@]}}\\\"; \"\n        \"}\"\n    )\n    run_shell(command)\n    return str(out)\nPY\n"]
[77.913433, "o", "cat > casebundle/exporter.py <<'PY'\r\n\u001b[?2004l\r"]
[77.913475, "o", "\u001b[?2004h> "]
