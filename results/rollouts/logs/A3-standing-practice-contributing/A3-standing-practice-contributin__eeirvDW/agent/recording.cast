[13.264886, "o", "('cases', 'CREATE TABLE cases ( id INTEGER PRIMARY KEY, internal_id INTEGER NOT NULL, ref TEXT NOT NULL, account TEXT NOT NULL, include_glob TEXT NOT NULL, retention_days INTEGER NOT NULL)')\r\n(1, 4471, 'CRM-2026-0118', 'Northwind Utilities', 'app.log*', 90)\r\n(2, 4472, 'CRM-2026-0119', 'Harrow Water', '*.log', 30)\r\n(3, 4473, 'CRM-2026-0125', 'Baltic Grid', 'app.log*', 365)\r\n"]
