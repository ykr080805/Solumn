[22.672086, "o", "\u001b[?2004h> from casebundle.store import list_cases\r\n\u001b[?2004l\r\u001b[?2004h> for c in list_cases():\r\n\u001b[?2004l\r\u001b[?2004h>     print(c)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[22.814605, "o", "Case(id=1, internal_id=4471, ref='CRM-2026-0118', account='Northwind Utilities', include_glob='app.log*', retention_days=90)\r\nCase(id=2, internal_id=4472, ref='CRM-2026-0119', account='Harrow Water', include_glob='*.log', retention_days=30)\r\nCase(id=3, internal_id=4473, ref='CRM-2026-0125', account='Baltic Grid', include_glob='app.log*', retention_days=365)\r\nCase(id=4, internal_id=4480, ref='CRM-2026-0131', account='Northwind Utilities', include_glob='collector-*.log', retention_days=90)\r\nCase(id=5, internal_id=4490, ref='CRM-2026-0140', account='Harrow Water', include_glob='{app,pump}.log', retention_days=30)\r\n"]
