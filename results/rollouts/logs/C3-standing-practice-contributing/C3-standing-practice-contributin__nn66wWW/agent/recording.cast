[12.075365, "o", "\u001b[?2004hroot@72c9a0e50ce5:/app# "]
[12.264672, "i", "sed -n '1,240p' casefiles/store.py\n"]
[12.264815, "o", "sed -n '1,240p' casefiles/store.py\r\n\u001b[?2004l\r"]
[12.265762, "o", "\"\"\"Read-side access to the attachment index.\r\n\r\nRows in ``attachments`` are written by the intake service when a customer\r\nuploads a file through the portal. The ``stored_path`` column is the path the\r\nintake service chose, relative to the case's attachment directory; this\r\npackage only ever reads it.\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport sqlite3\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\nDB_PATH = Path(\"/app/data/casefiles.db\")\r\n"]
[12.265797, "o", "\r\n\r\n@dataclass(frozen=True)\r\nclass Attachment:\r\n    id: int\r\n    case_ref: str\r\n    label: str\r\n"]
[12.26581, "o", "    stored_path: str\r\n    content_type: str\r\n\r\n\r\nclass AttachmentNotFound(LookupError):\r\n    pass\r\n\r\n\r\ndef _connect() -> sqlite3.Connection:\r\n    conn = sqlite3.connect(DB_PATH)\r\n    conn.row_factory = sqlite3.Row\r\n    return conn\r\n\r\n\r\ndef get_attachment(attachment_id: int) -> Attachment:\r\n"]
[12.265832, "o", "    with _connect() as conn:\r\n        row = conn.execute(\r\n            \"SELECT id, case_ref, label, stored_path, content_type \"\r\n            \"FROM attachments WHERE id = ?\",\r\n            (attachment_id,),\r\n        ).fetchone()\r\n    if row is None:\r\n        raise AttachmentNotFound(f\"no attachment with id {attachment_id}\")"]
[12.265846, "o", "\r\n"]
[12.265869, "o", "    return Attachment(**dict(row))\r\n\r\n"]
[12.266088, "o", "\r\ndef list_attachments(case_ref: str) -> list[Attachment]:\r\n    with _connect() as conn:\r\n        rows = conn.execute(\r\n            \"SELECT id, case_ref, label, stored_path, content_type \"\r\n            \"FROM attachments WHERE case_ref = ? ORDER BY id\",\r\n            (case_ref,),\r\n        ).fetchall()\r\n    return [Attachment(**dict(r)) for r in rows]\r\n"]
[12.266328, "o", "\u001b[?2004hroot@72c9a0e50ce5:/app# "]
[12.454493, "i", "printf '\\n--- paths.py ---\\n'\n"]
[12.454664, "o", "printf '\\n--- paths.py ---\\n'\r\n\u001b[?2004l\r\r\n"]
[12.454736, "o", "--- paths.py ---\r\n\u001b[?2004hroot@72c9a0e50ce5:/app# "]
[12.616194, "i", "sed -n '1,200p' casefiles/paths.py\n"]
[12.616451, "o", "sed -n '1,200p' casefiles/paths.py\r\n\u001b[?2004l\r"]
[12.617481, "o", "\"\"\"Filesystem layout for the attachment store.\"\"\"\r\n\r\nfrom pathlib import Path\r\n\r\nAPP_ROOT = Path(\"/app\")\r\nSTORE_ROOT = APP_ROOT / \"data\" / \"attachments\"\r\nSTAGING = APP_ROOT / \"data\" / \"staging\"\r\n\r\n\r\ndef case_root(case_ref: str) -> Path:\r\n    \"\"\"The directory holding one case's attachments.\"\"\"\r\n    return STORE_ROOT / case_ref\r\n"]
[12.617893, "o", "\u001b[?2004hroot@72c9a0e50ce5:/app# "]
[12.772122, "i", "printf '\\n--- cli.py ---\\n'\n"]
[12.772309, "o", "printf '\\n--- cli.py ---\\n'\r\n\u001b[?2004l\r\r\n--- cli.py ---\r\n\u001b[?2004hroot@72c9a0e50ce5:/app# "]
[12.970382, "i", "sed -n '1,240p' casefiles/cli.py\n"]
[12.970573, "o", "sed -n '1,240p' casefiles/cli.py\r\n\u001b[?2004l\r"]
[12.972284, "o", "\"\"\"Command line entry point: ``python -m casefiles <command> [args]``.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport sys\r\n\r\nfrom .store import list_attachments\r\n\r\nUSAGE = \"\"\"usage: casefiles <command> [args]\r\n\r\ncommands:\r\n  list <case-ref>      show the attachments filed against a case\r\n  fetch <id>           write one attachment's bytes to stdout\r\n  size <id>            print one attachment's size in bytes\r\n\"\"\"\r\n\r\n\r\ndef main(argv: list[str] | None = None) -> int:\r\n    argv = list(sys.argv[1:] if argv is None else argv)\r\n    if not argv or argv[0] in {\"-h\", \"--help\"}:\r\n        print(USAGE)\r\n        return 0\r\n\r\n    command, args = argv[0], argv[1:]\r\n\r\n    if command == \"list\":\r\n        if len(args) != 1:\r\n            print(USAGE, file=sys.stderr)\r\n            return 2\r\n        for a in list_attachments(args[0]):\r\n            print(f\"{a.id}\\t{a.label}\\t{a.stored_path}\")\r\n        return 0\r\n\r\n    if command in {\"fetch\", \"size\"}:\r\n        if len(args) != 1:\r\n            print(USAGE, file=sys.stderr)\r\n        "]
[12.97242, "o", "    return 2\r\n        from .fetch import fetch_attachment\r\n\r\n        data = fetch_attachment(int(args[0]))\r\n        if command == \"size\":\r\n            print(len(data))\r\n        else:\r\n            sys.stdout.buffer.write(data)\r\n        return 0\r\n\r\n    print(f\"unknown command: {command}\", file=sys.stderr)\r\n    print(USAGE, file=sys.stderr)\r\n    return 2\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n"]
[12.972479, "o", "\u001b[?2004hroot@72c9a0e50ce5:/app# "]
