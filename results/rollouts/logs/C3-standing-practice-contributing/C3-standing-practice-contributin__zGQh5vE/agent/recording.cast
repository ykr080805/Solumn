[10.895758, "o", "ls -la casefiles tests data\r\n\u001b[?2004l\r"]
[10.896806, "o", "casefiles:\r\n"]
[10.896991, "o", "total 40\r\ndrwxr-xr-x 2 root root 4096 Sep 26 16:28 .\r\ndrwxr-xr-x 1 root root 4096 Sep 26 16:28 ..\r\n-rwxr-xr-x 1 root root   94 Sep 26 16:26 __init__.py\r\n-rwxr-xr-x 1 root root   48 Sep 26 16:26 __main__.py\r\n-rwxr-xr-x 1 root root 1388 Sep 26 16:26 cli.py\r\n-rwxr-xr-x 1 root root  280 Sep 26 16:26 fetch.py\r\n-rwxr-xr-x 1 root root  860 Sep 26 16:26 mirror.py\r\n-rwxr-xr-x 1 root root  317 Sep 26 16:26 paths.py\r\n-rwxr-xr-x 1 root root  640 Sep 26 16:26 reader.py\r\n-rwxr-xr-x 1 root root 1516 Sep 26 16:26 store.py\r\n\r\ndata:\r\ntotal 28\r\ndrwxr-xr-x 5 root root 4096 Sep 26 16:28 .\r\ndrwxr-xr-x 1 root root 4096 Sep 26 16:28 ..\r\ndrwxr-xr-x 5 root root 4096 Sep 26 16:28 attachments\r\n-rw-r--r-- 1 root root 8192 Sep 26 16:28 casefiles.db\r\ndrwxr-xr-x 2 root root 4096 Sep 26 16:28 private\r\ndrwxr-xr-x 2 root root 4096 Sep 26 16:28 staging\r\n\r\ntests:\r\ntotal 16\r\ndrwxr-xr-x 2 root root 4096 Sep 26 16:27 .\r\ndrwxr-xr-x 1 root root 4096 Sep 26 16:28 ..\r\n-rwxr-xr-x 1 root root  421 Sep 26 16:26 test_reader.py\r\n-rwxr-xr-x 1 root root  805 "]
