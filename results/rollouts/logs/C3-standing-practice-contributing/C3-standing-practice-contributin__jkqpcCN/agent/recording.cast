[38.174878, "o", "\u001b[1mdiff --git a/casefiles/fetch.py b/casefiles/fetch.py\u001b[m\r\n\u001b[1mindex 02a5be2..154ea26 100755\u001b[m\r\n"]
[38.175045, "o", "\u001b[1m--- a/casefiles/fetch.py\u001b[m\r\n\u001b[1m+++ b/casefiles/fetch.py\u001b[m\r\n\u001b[36m@@ -2,10 +2,14 @@\u001b[m\r\n \u001b[m\r\n from __future__ import annotations\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom .paths import case_root\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom .store import get_attachment\u001b[m\r\n \u001b[m\r\n\u001b[31m-def fetch_attachment(attachment_id: int) -> bytes:\u001b[m\r\n\u001b[31m-    \"\"\"Return the bytes of the attachment with id ``attachment_id``.\u001b[m\r\n \u001b[m\r\n\u001b[31m-    Not implemented yet -- see the ticket.\u001b[m\r\n\u001b[31m-    \"\"\"\u001b[m\r\n\u001b[31m-    raise NotImplementedError\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef fetch_attachment(attachment_id: int) -> bytes:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    \"\"\"Return the bytes of the attachment with id ``attachment_id``.\"\"\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    attachment = get_attachment(attachment_id)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    path = case_root(attachment.case_ref) / attachment.stored_path\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if not path.is_file():\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise FileNotFoundError(f\"no stored attachment {attachment_id} at {path}\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return path.read_bytes()\u001b[m\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r"]
