[14.831608, "i", "python - <<'PY'\nimport sqlite3\ncon = sqlite3.connect('data/casefiles.db')\nfor row in con.execute(\"select name, sql from sqlite_master where type='table' order by name\"):\n    print(row[0], row[1])\nprint('attachments:')\nfor row in con.execute('select * from attachments order by id'):\n    print(row)\nPY\n"]
[14.831887, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
