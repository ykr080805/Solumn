[14.873389, "o", "attachments CREATE TABLE attachments ( id INTEGER PRIMARY KEY, case_ref TEXT NOT NULL, label TEXT NOT NULL, stored_path TEXT NOT NULL, content_type TEXT NOT NULL)\r\nattachments:\r\n"]
[14.873605, "o", "(1, 'CRM-2026-0118', 'February invoice', 'invoices/2026-02/inv-4471.pdf', 'application/pdf')\r\n(2, 'CRM-2026-0118', 'Meter photo, site A', 'photos/site-a/meter.jpg', 'image/jpeg')\r\n(3, 'CRM-2026-0118', 'Signed acceptance', 'acceptance.pdf', 'application/pdf')\r\n(4, 'CRM-2026-0119', 'January invoice', 'invoices/2026-01/inv-4472.pdf', 'application/pdf')\r\n(5, 'CRM-2026-0119', 'Pump serial plate', 'photos/pump-4/plate.jpg', 'image/jpeg')\r\n(6, 'CRM-2026-0125', 'Outage timeline', 'reports/outage-timeline.txt', 'text/plain')\r\n"]
[14.877084, "o", "\u001b[?2004hroot@30bb51bf9010:/app# "]
[27.582238, "i", "cat > casefiles/fetch.py <<'PY'\n\"\"\"Customer-facing attachment fetch.\"\"\"\n\nfrom __future__ import annotations\n\nfrom .paths import case_root\nfrom .store import get_attachment\n\n\ndef fetch_attachment(attachment_id: int) -> bytes:\n    \"\"\"Return the bytes of the attachment with id ``attachment_id``.\n\n    Attachment files are stored under the directory for their case. The\n    ``stored_path`` from the attachment index is relative to that directory and\n    may include directory components, so it must be joined as-is rather than\n    flattened to its final filename.\n    \"\"\"\n    attachment = get_attachment(attachment_id)\n    path = case_root(attachment.case_ref) / attachment.stored_path\n    if not path.is_file():\n        raise FileNotFoundError(\n            f\"attachment {attachment_id} is missing from the store: {path}\"\n        )\n    return path.read_bytes()\nPY\n"]
[27.58253, "o", "cat > casefiles/fetch.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"Customer-facing attachment fetch.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from __future__ import annotations\r\n\u001b[?2004l\r"]
[27.582611, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.582697, "o", "from .paths import case_root\r\n\u001b[?2004l\r\u001b[?2004h> from .store import get_attachment\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[27.582801, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[27.582832, "o", "> def fetch_attachment(attachment_id: int) -> bytes:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.583021, "o", "    \"\"\"Return the bytes of the attachment with id ``attachment_id``.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     Attachment files are stored under the directory for their case. The\r\n\u001b[?2004l\r"]
[27.583228, "o", "\u001b[?2004h>     ``stored_path`` from the attachment index is relative to that directory and\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.583556, "o", "    may include directory components, so it must be joined as-is rather than\r\n\u001b[?2004l\r\u001b[?2004h>     flattened to its final filename.\r\n\u001b[?2004l\r\u001b[?2004h>     \"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     attachment = get_attachment(attachment_id)\r\n\u001b[?2004l\r\u001b[?2004h>     path = case_root(attachment.case_ref) / attachment.stored_path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.583664, "o", "    if not path.is_file():\r\n\u001b[?2004l\r\u001b[?2004h>         raise FileNotFoundError(\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.583768, "o", "            f\"attachment {attachment_id} is missing from the store: {path}\"\r\n\u001b[?2004l\r\u001b[?2004h>         )\r\n\u001b[?2004l\r\u001b[?2004h>     return path.read_bytes()\r\n\u001b[?2004l\r"]
[27.584022, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[27.585098, "o", "\u001b[?2004hroot@30bb51bf9010:/app# "]
