[19.506041, "i", "cat > casefiles/fetch.py <<'PY'\n\"\"\"Customer-facing attachment fetch.\"\"\"\n\nfrom __future__ import annotations\n\nfrom .paths import case_root\nfrom .store import get_attachment\n\n\ndef fetch_attachment(attachment_id: int) -> bytes:\n    \"\"\"Return the bytes of the attachment with id ``attachment_id``.\n\n    The attachment index stores ``stored_path`` relative to the attachment's\n    case directory. Preserve that relative path when reading from the store so\n    attachments that share a final filename but live in different folders stay\n    distinct.\n    \"\"\"\n    attachment = get_attachment(attachment_id)\n    return (case_root(attachment.case_ref) / attachment.stored_path).read_bytes()\nPY\n\npython -m casefiles size 1\npython -m casefiles fetch 1\npython - <<'PY'\nfrom casefiles.fetch import fetch_attachment\nfrom pathlib import Path\n\nchecks = {\n    2: Path('/app/data/attachments/CRM-2026-0118/photos/site-a/meter.jpg'),\n    3: Path('/app/data/attachments/CRM-2026-0118/acceptance.pdf'),\n    6: Path('/app/data/attachments/CRM-2026"]
[19.506119, "i", "-0125/reports/outage-timeline.txt'),\n}\nfor attachment_id, path in checks.items():\n    assert fetch_attachment(attachment_id) == path.read_bytes(), attachment_id\n    print(attachment_id, len(fetch_attachment(attachment_id)))\nPY\npython -m pytest tests -q\n"]
