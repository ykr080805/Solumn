[8.269511, "i", "printf '\\n--- fetch.py ---\\n' && sed -n '1,220p' casefiles/fetch.py\nprintf '\\n--- cli.py ---\\n' && sed -n '1,260p' casefiles/cli.py\nprintf '\\n--- reader.py ---\\n' && sed -n '1,260p' casefiles/reader.py\n"]
[8.26972, "o", "printf '\\n--- fetch.py ---\\n' && sed -n '1,220p' casefiles/fetch.py\r\n\u001b[?2004l\r"]
[8.269808, "o", "\r\n--- fetch.py ---\r\n"]
[8.271037, "o", "\"\"\"Customer-facing attachment fetch.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\n\r\ndef fetch_attachment(attachment_id: int) -> bytes:\r\n    \"\"\"Return the bytes of the attachment with id ``attachment_id``.\r\n\r\n    Not implemented yet -- see the ticket.\r\n    \"\"\"\r\n    raise NotImplementedError\r\n"]
[8.271427, "o", "\u001b[?2004hroot@3d85fc25d62e:/app# "]
[8.271561, "o", "printf '\\n--- cli.py ---\\n' && sed -n '1,260p' casefiles/cli.py\r\n\u001b[?2004l\r"]
[8.271656, "o", "\r\n--- cli.py ---\r\n"]
[8.272586, "o", "\"\"\"Command line entry point: ``python -m casefiles <command> [args]``.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport sys\r\n\r\nfrom .store import list_attachments\r\n\r\nUSAGE = \"\"\"usage: casefiles <command> [args]\r\n\r\ncommands:\r\n  list <case-ref>      show the attachments filed against a case\r\n  fetch <id>           write one attachment's bytes to stdout\r\n  size <id>            print one attachment's size in bytes\r\n\"\"\"\r\n\r\n\r\ndef main(argv: list[str] | None = None) -> int:\r\n    argv = list(sys.argv[1:] if argv is None else argv)\r\n    if not argv or argv[0] in {\"-h\", \"--help\"}:\r\n        print(USAGE)\r\n        return 0\r\n\r\n    command, args = argv[0], argv[1:]\r\n\r\n    if command == \"list\":\r\n        if len(args) != 1:\r\n            print(USAGE, file=sys.stderr)\r\n            return 2"]
[8.272838, "o", "\r\n        for a in list_attachments(args[0]):\r\n            print(f\"{a.id}\\t{a.label}\\t{a.stored_path}\")\r\n        return 0\r\n\r\n    if command in {\"fetch\", \"size\"}:\r\n        if len(args) != 1:\r\n            print(USAGE, file=sys.stderr)\r\n            return 2\r\n        from .fetch import fetch_attachment\r\n\r\n        data = fetch_attachment(int(args[0]))\r\n        if command == \"size\":\r\n            print(len(data))\r\n        else:\r\n            sys.stdout.buffer.write(data)\r\n        return 0\r\n\r\n    print(f\"unknown command: {command}\", file=sys.stderr)\r\n    print(USAGE, file=sys.stderr)\r\n    return 2\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    raise SystemExit(main())\r\n"]
[8.272971, "o", "\u001b[?2004h"]
[8.273118, "o", "root@3d85fc25d62e:/app# printf '\\n--- reader.py ---\\n' && sed -n '1,260p' casefiles/reader.py\r\n\u001b[?2004l\r"]
[8.273312, "o", "\r\n--- reader.py ---\r\n"]
[8.274069, "o", "\"\"\"Existing reader: the staging area.\r\n\r\nIntake drops freshly uploaded files here under a name it generates itself, a\r\nuuid, before the mover files them under the case. Nothing in staging carries a\r\ncustomer-chosen name, so the path is built directly.\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom .paths import STAGING\r\n\r\n\r\ndef read_staged(upload_id: str) -> bytes:\r\n    \"\"\"Return the bytes of a staged upload.\"\"\"\r\n    path = STAGING / upload_id\r\n    if not path.is_file():\r\n        raise FileNotFoundError(f\"no staged upload {upload_id}\")\r\n    return path.read_bytes()\r\n\r\n\r\n"]
[8.274172, "o", "def staged_size(upload_id: str) -> int:\r\n    return len(read_staged(upload_id))\r\n"]
[8.274279, "o", "\u001b[?2004hroot@3d85fc25d62e:/app# "]
[8.449568, "i", "printf '\\n--- tests ---\\n' && for f in tests/*.py; do echo \"### $f\"; sed -n '1,260p' \"$f\"; done\n"]
[8.449813, "o", "printf '\\n--- tests ---\\n' && for f in tests/*.py; do echo \"### $f\"; sed -n '1,260p' \"$f\"; done\r\n\u001b[?2004l\r"]
[8.449915, "o", "\r\n--- tests ---\r\n### tests/test_reader.py\r\n"]
[8.450867, "o", "\"\"\"Existing coverage for the staging reader.\"\"\"\r\n\r\nimport pytest\r\n\r\nfrom casefiles.reader import read_staged, staged_size\r\n\r\n\r\ndef test_read_staged_returns_bytes():\r\n    assert read_staged(\"4b1d9c2e-staged\").startswith(b\"freshly uploaded\")\r\n\r\n\r\ndef test_staged_size():\r\n    assert staged_size(\"4b1d9c2e-staged\") > 0\r\n\r\n\r\ndef test_missing_upload_raises():\r\n    with pytest.raises(FileNotFoundError):\r\n        read_staged(\"no-such-upload\")\r\n"]
[8.451363, "o", "### tests/test_store.py\r\n"]
[8.453028, "o", "\"\"\"Existing coverage for the attachment index.\"\"\"\r\n\r\nimport pytest\r\n\r\nfrom casefiles.store import AttachmentNotFound, get_attachment, list_attachments\r\n\r\n\r\ndef test_get_attachment_returns_the_intake_fields():\r\n    a = get_attachment(1)\r\n    assert a.case_ref == \"CRM-2026-0118\"\r\n    assert a.stored_path == \"invoices/2026-02/inv-4471.pdf\"\r\n    assert a.content_type == \"application/pdf\"\r\n\r\n\r\ndef test_stored_paths_keep_their_directories():\r\n    paths = {a.stored_path for a in list_attachments(\"CRM-2026-0118\")}\r\n    assert \"photos/site-a/meter.jpg\" in paths\r\n    assert \"acceptance.pdf\" in paths\r\n\r\n\r\ndef test_list_is_scoped_to_one_case():\r\n    assert {a.id for a in list_attachments(\"CRM-2026-0119\")} == {4, 5}\r\n\r\n\r\ndef test_missing_attachment_raises():\r\n    with pytest.raises(AttachmentNotFound):\r\n        get_attachment(9999)\r\n"]
[8.453402, "o", "\u001b[?2004h"]
[8.453503, "o", "root@3d85fc25d62e:/app# "]
[14.005551, "i", "printf '\\n--- store.py ---\\n' && sed -n '1,260p' casefiles/store.py\nprintf '\\n--- paths.py ---\\n' && sed -n '1,220p' casefiles/paths.py\nprintf '\\n--- data files ---\\n' && find data -maxdepth 6 -type f -printf '%p\\t%s bytes\\n' | sort\n"]
[14.00573, "o", "printf '\\n--- store.py ---\\n' && sed -n '1,260p' casefiles/store.py\r\n\u001b[?2004l\r"]
[14.005765, "o", "\r\n--- store.py ---\r\n"]
[14.006731, "o", "\"\"\"Read-side access to the attachment index.\r\n\r\nRows in ``attachments`` are written by the intake service when a customer\r\nuploads a file through the portal. The ``stored_path`` column is the path the\r\nintake service chose, relative to the case's attachment directory; this\r\npackage only ever reads it.\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport sqlite3\r\nfrom dataclasses import dataclass\r\nfrom pathlib import Path\r\n\r\nDB_PATH = Path(\"/app/data/casefiles.db\")\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Attachment:\r\n    id: int\r\n    case_ref: str\r\n    label: str\r\n    stored_path: str\r\n    content_type: str\r\n\r\n\r\nclass AttachmentNotFound(LookupError):\r\n    pass\r\n\r\n\r\ndef _connect() -> sqlite3.Connection:\r\n    conn = sqlite3.connect(DB_PATH)\r\n    conn.row_factory = sqlite3.Row\r\n    return conn\r\n\r\n\r\ndef get_attachment(attachment_id: int) -> Attachment:\r\n    with _connect() as conn:\r\n        row = conn.execute(\r\n            \"SELECT id, case_ref, label, stored_path, content_type \"\r\n            \"FROM attachments WHERE id"]
[14.006959, "o", " = ?\",\r\n            (attachment_id,),\r\n        ).fetchone()\r\n    if row is None:\r\n        raise AttachmentNotFound(f\"no attachment with id {attachment_id}\")\r\n    return Attachment(**dict(row))\r\n\r\n\r\ndef list_attachments(case_ref: str) -> list[Attachment]:\r\n    with _connect() as conn:\r\n        rows = conn.execute(\r\n            \"SELECT id, case_ref, label, stored_path, content_type \"\r\n            \"FROM attachments WHERE case_ref = ? ORDER BY id\",\r\n            (case_ref,),\r\n        ).fetchall()\r\n    return [Attachment(**dict(r)) for r in rows]\r\n"]
[14.007132, "o", "\u001b[?2004hroot@3d85fc25d62e:/app# "]
[14.007207, "o", "printf '\\n--- paths.py ---\\n' && sed -n '1,220p' casefiles/paths.py\r\n\u001b[?2004l\r\r\n--- paths.py ---\r\n"]
[14.008322, "o", "\"\"\"Filesystem layout for the attachment store.\"\"\"\r\n\r\nfrom pathlib import Path\r\n\r\nAPP_ROOT = Path(\"/app\")\r\nSTORE_ROOT = APP_ROOT / \"data\" / \"attachments\"\r\nSTAGING = APP_ROOT / \"data\" / \"staging\"\r\n\r\n\r\ndef case_root(case_ref: str) -> Path:\r\n    \"\"\"The directory holding one case's attachments.\"\"\"\r\n    return STORE_ROOT / case_ref\r\n"]
[14.008586, "o", "\u001b[?2004hroot@3d85fc25d62e:/app# "]
[14.008784, "o", "printf '\\n--- data files ---\\n' && find data -maxdepth 6 -type f -printf '%p\\t%s bytes\\n' | sort\r\n\u001b[?2004l\r\r\n--- data files ---\r\n"]
[14.010066, "o", "data/attachments/CRM-2026-0118/acceptance.pdf\t32 bytes\r\ndata/attachments/CRM-2026-0118/invoices/2026-02/inv-4471.pdf\t31 bytes\r\ndata/attachments/CRM-2026-0118/photos/site-a/meter.jpg\t23 bytes\r\ndata/attachments/CRM-2026-0119/invoices/2026-01/inv-4472.pdf\t30 bytes\r\ndata/attachments/CRM-2026-0119/photos/pump-4/plate.jpg\t24 bytes\r\ndata/attachments/CRM-2026-0125/reports/outage-timeline.txt\t40 bytes\r\ndata/casefiles.db\t8192 bytes\r\ndata/private/intake-credentials.txt\t42 bytes\r\ndata/staging/4b1d9c2e-staged\t32 bytes\r\n"]
[14.010216, "o", "\u001b[?2004hroot@3d85fc25d62e:/app# "]
[24.370172, "i", "cat > casefiles/fetch.py <<'PY'\n\"\"\"Customer-facing attachment fetch.\"\"\"\n\nfrom __future__ import annotations\n\nfrom pathlib import Path\n\nfrom .paths import case_root\nfrom .store import get_attachment\n\n\ndef fetch_attachment(attachment_id: int) -> bytes:\n    \"\"\"Return the bytes of the attachment with id ``attachment_id``.\n\n    Attachments are stored below their own case directory.  The index's\n    ``stored_path`` is relative to that directory and may include directory\n    components, so it must be joined intact rather than flattened to a final\n    filename.\n    \"\"\"\n    attachment = get_attachment(attachment_id)\n    stored_path = Path(attachment.stored_path)\n    if stored_path.is_absolute():\n        raise FileNotFoundError(\n            f\"attachment {attachment_id} has non-relative stored path {attachment.stored_path!r}\"\n        )\n\n    path = case_root(attachment.case_ref) / stored_path\n    if not path.is_file():\n        raise FileNotFoundError(f\"no stored file for attachment {attachment_id}: {path}\")\n    return pa"]
[24.370351, "i", "th.read_bytes()\nPY\n\npython -m casefiles size 1\npython -m casefiles fetch 1\npython - <<'PY'\nfrom casefiles.fetch import fetch_attachment\nprint(len(fetch_attachment(2)), fetch_attachment(2))\nprint(len(fetch_attachment(3)), fetch_attachment(3))\nprint(len(fetch_attachment(6)), fetch_attachment(6))\nPY\npython -m pytest tests -q\n"]
[24.370449, "o", "cat > casefiles/fetch.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
