[27.366473, "i", "cat > casefiles/fetch.py <<'PY'\n\"\"\"Customer-facing attachment fetch.\"\"\"\n\nfrom __future__ import annotations\n\nfrom .paths import case_root\nfrom .store import get_attachment\n\n\ndef fetch_attachment(attachment_id: int) -> bytes:\n    \"\"\"Return the bytes of the attachment with id ``attachment_id``.\n\n    The attachment index stores ``stored_path`` relative to the attachment's\n    case directory. Preserve that relative path so files with the same final\n    filename in different folders remain distinct.\n    \"\"\"\n    attachment = get_attachment(attachment_id)\n    return (case_root(attachment.case_ref) / attachment.stored_path).read_bytes()\nPY\n"]
