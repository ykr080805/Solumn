[26.703896, "i", "cat > tests/test_fetch.py <<'PY'\n\"\"\"Coverage for customer-facing attachment fetch.\"\"\"\n\nimport pytest\n\nfrom casefiles.fetch import fetch_attachment\nfrom casefiles.store import AttachmentNotFound\n\n\ndef test_fetch_preserves_nested_path_for_site_photo():\n    assert fetch_attachment(2) == (\n        b\"CRM-2026-0118 photos/site-a/meter.jpg\\n\"\n        b\"meter reading: 1042 kWh\\n\"\n    )\n\n\ndef test_fetch_preserves_nested_path_for_same_final_filename():\n    assert fetch_attachment(5) == (\n        b\"CRM-2026-0119 photos/pump-4/plate.jpg\\n\"\n        b\"serial: PUMP-4-8841\\n\"\n    )\n\n\ndef test_fetch_top_level_file():\n    assert fetch_attachment(3).startswith(b\"CRM-2026-0118 acceptance.pdf\")\n\n\ndef test_fetch_missing_attachment_raises():\n    with pytest.raises(AttachmentNotFound):\n        fetch_attachment(9999)\nPY\n"]
